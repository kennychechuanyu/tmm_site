---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  subtitle?: string;
  eyebrow?: string;
  compact?: boolean;
  image?: string;
  noindex?: boolean;
}

const { title, description, subtitle, eyebrow, compact = false, image, noindex } = Astro.props;
---

<BaseLayout title={title} description={description} image={image} noindex={noindex}>
  <section class:list={["page-head", compact && "is-compact"]}>
    <div class="container-wide">
      {eyebrow && <p class="page-kicker">{eyebrow}</p>}
      <h1 class="page-title">{title}</h1>
      {subtitle && <p class="page-sub">{subtitle}</p>}
    </div>
  </section>

  <slot />
</BaseLayout>
