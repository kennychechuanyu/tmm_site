---
import { subscribeHref } from "../utils/newsletter";

interface Props {
  compact?: boolean;
  note?: string;
}
const {
  compact = false,
  note = "Google sends one confirmation email; reply to it and you are on the list. Unsubscribe from any message.",
} = Astro.props;
---

{subscribeHref && (
  <div class:list={["flex flex-col", compact ? "gap-2" : "gap-3"]}>
    <div>
      <a href={subscribeHref} class:list={["btn-primary", compact ? "px-3 py-1.5 text-sm" : "px-5 py-2.5 text-sm"]}>
        Join the mailing list
      </a>
    </div>
    {note && (
      <p class:list={["font-sans text-slate-500 dark:text-slate-400", compact ? "text-xs" : "text-sm"]}>{note}</p>
    )}
  </div>
)}
