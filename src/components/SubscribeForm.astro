---
/**
 * Mailing-list sign-up for the Google Group: a one-click link that opens an
 * email to the subscribe address, with the address shown for anyone whose
 * mail client does not open links. Renders nothing until GOOGLE_GROUP is set
 * in src/utils/newsletter.ts.
 */
import { subscribeAddress, subscribeHref } from "../utils/newsletter";

interface Props {
  /** Tighter spacing for the footer. */
  compact?: boolean;
  /** Text under the link; pass an empty string to omit. */
  note?: string;
}
const {
  compact = false,
  note = "Google sends one confirmation email; reply to it and you are on the list. Unsubscribe from any message.",
} = Astro.props;
---

{subscribeHref && (
  <div class:list={["flex flex-col", compact ? "gap-2" : "gap-3"]}>
    <div class:list={["flex items-center", compact ? "flex-col items-start gap-y-2" : "flex-wrap gap-x-4 gap-y-2"]}>
      <a href={subscribeHref} class:list={["btn-primary", compact ? "px-3 py-1.5 text-sm" : "px-5 py-2.5 text-sm"]}>
        Join the mailing list
      </a>
      <span class:list={["font-sans text-slate-500 dark:text-slate-400", compact ? "text-xs" : "text-sm"]}>
        or email <span class:list={["whitespace-nowrap font-mono text-slate-700 dark:text-slate-300", compact && "text-[11px]"]}>{subscribeAddress}</span>
      </span>
    </div>
    {note && (
      <p class:list={["font-sans text-slate-500 dark:text-slate-400", compact ? "text-xs" : "text-sm"]}>{note}</p>
    )}
  </div>
)}
