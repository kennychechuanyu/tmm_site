---
---

<dialog
  id="search-modal"
  class="search-dialog w-[calc(100%-2rem)] max-w-2xl rounded-md border border-slate-200 bg-white p-0 text-slate-900 shadow-2xl dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
  aria-label="Search"
>
  <div class="max-h-[80vh] overflow-y-auto p-3 sm:p-4">
    <div id="search"></div>
    <div
      class="mt-3 flex items-center justify-between gap-4 border-t border-slate-100 px-1 pt-3 font-sans text-xs text-slate-500 dark:border-slate-800 dark:text-slate-400"
    >
      <span>Search papers, people, events &amp; news</span>
      <span class="flex items-center gap-1.5">
        <kbd class="rounded-sm border border-slate-200 px-1.5 py-px font-sans text-[11px] dark:border-slate-700">Esc</kbd>
        to close
      </span>
    </div>
  </div>
</dialog>

<script>
  (() => {
    if ((window as any).__tmmSearchBound) return;
    (window as any).__tmmSearchBound = true;

    let libReady: Promise<boolean> | null = null;

    function loadLib(): Promise<boolean> {
      if (libReady) return libReady;
      libReady = new Promise<boolean>((resolve) => {
        const css = document.createElement("link");
        css.rel = "stylesheet";
        css.href = "/pagefind/pagefind-ui.css";
        document.head.appendChild(css);

        const js = document.createElement("script");
        js.src = "/pagefind/pagefind-ui.js";
        js.onload = () => resolve(true);
        js.onerror = () => resolve(false);
        document.head.appendChild(js);
      });
      return libReady;
    }

    function getModal(): HTMLDialogElement | null {
      return document.getElementById("search-modal") as HTMLDialogElement | null;
    }

    async function openSearch() {
      const modal = getModal();
      if (!modal) return;
      const mount = document.getElementById("search");
      const ok = await loadLib();
      const PagefindUI = (window as any).PagefindUI;

      if (ok && PagefindUI && mount && mount.childElementCount === 0) {
        new PagefindUI({
          element: "#search",
          showSubResults: true,
          showImages: false,
          resetStyles: false,
          autofocus: true,
          placeholder: "Search the TMM network…",
        });
      } else if (!ok && mount && mount.childElementCount === 0) {
        mount.innerHTML =
          '<p class="px-1 py-8 text-center font-sans text-sm text-slate-500 dark:text-slate-400">Search runs on the built site. Visit the live site or run a production build to use it.</p>';
      }

      if (!modal.open) modal.showModal();
      requestAnimationFrame(() => {
        const input = modal.querySelector("input");
        if (input) (input as HTMLInputElement).focus();
      });
    }

    function closeSearch() {
      const modal = getModal();
      if (modal && modal.open) modal.close();
    }

    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      if (target.closest("[data-search-open]")) {
        e.preventDefault();
        openSearch();
        return;
      }
      const modal = getModal();
      if (modal && e.target === modal) closeSearch();
    });

    document.addEventListener("keydown", (e) => {
      const tag = (e.target as HTMLElement)?.tagName;
      const typing = tag === "INPUT" || tag === "TEXTAREA" || tag === "SELECT";
      const modal = getModal();
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
        e.preventDefault();
        modal && modal.open ? closeSearch() : openSearch();
      } else if (e.key === "/" && !typing && !(modal && modal.open)) {
        e.preventDefault();
        openSearch();
      }
    });
  })();
</script>

<style is:global>
  dialog.search-dialog {
    margin: 9vh auto auto;
  }
  dialog.search-dialog::backdrop {
    background: rgba(15, 23, 42, 0.4);
    backdrop-filter: blur(3px);
  }

  #search-modal .pagefind-ui {
    --pagefind-ui-scale: 0.9;
    --pagefind-ui-primary: #264275;
    --pagefind-ui-text: #334155;
    --pagefind-ui-background: #ffffff;
    --pagefind-ui-border: #e2e8f0;
    --pagefind-ui-tag: #f1f5f9;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 4px;
    --pagefind-ui-font: "Source Sans 3", ui-sans-serif, system-ui, sans-serif;
  }
  .dark #search-modal .pagefind-ui {
    --pagefind-ui-primary: #a2bdec;
    --pagefind-ui-text: #e2e8f0;
    --pagefind-ui-background: #0f172a;
    --pagefind-ui-border: #334155;
    --pagefind-ui-tag: #1e293b;
  }

  #search-modal .pagefind-ui__search-input {
    font-weight: 500;
  }
  #search-modal .pagefind-ui__result-title {
    font-family: "Brygada 1918", Georgia, serif;
  }
  #search-modal .pagefind-ui__result-link:hover {
    text-decoration: underline;
  }
  #search-modal .pagefind-ui__result-excerpt mark {
    background: #e3edff;
    color: #1b325e;
    border-radius: 2px;
    padding: 0 1px;
  }
  .dark #search-modal .pagefind-ui__result-excerpt mark {
    background: rgba(38, 66, 117, 0.5);
    color: #e3edff;
  }
</style>
