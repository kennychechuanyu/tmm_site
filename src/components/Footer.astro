---
import SubscribeForm from "./SubscribeForm.astro";
import { subscribeHref } from "../utils/newsletter";
const currentYear = new Date().getFullYear();

const columns = [
  {
    heading: "Network",
    links: [
      { label: "About", href: "/about" },
      { label: "People", href: "/people" },
      { label: "Events", href: "/events" },
      { label: "News", href: "/news" },
    ],
  },
  {
    heading: "Participate",
    links: [
      { label: "Resources", href: "/resources" },
      { label: "Community", href: "/community" },
      { label: "Contact", href: "/contact" },
    ],
  },
];
---

<footer class="site-footer">
  <div class="container-wide py-14 md:py-16">
    <div class="grid gap-10 md:grid-cols-12">
      <div class="md:col-span-5">
        <a href="/" class="wordmark" aria-label="TMM, home">TMM</a>
        <p class="footer-text mt-4 max-w-sm">
          Bridging theory and measurement in psychological science.
        </p>
        <a href="/community" class="mt-4 inline-block font-sans text-[0.9375rem] font-semibold text-slate-900 underline underline-offset-[3px] dark:text-slate-100">
          Join the network
        </a>
      </div>

      {columns.map((col) => (
        <nav class="md:col-span-2" aria-label={col.heading}>
          <h3 class="footer-heading">{col.heading}</h3>
          <ul class="mt-4 space-y-2.5">
            {col.links.map((link) => (
              <li>
                <a href={link.href} class="footer-link">{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))}

      <div class="md:col-span-3">
        <h3 class="footer-heading">Connect</h3>
        <div class="mt-4">
          <a href="mailto:tmm.psych@outlook.com" class="footer-link">tmm.psych@outlook.com</a>
        </div>
        {subscribeHref && (
          <div class="mt-6">
            <p class="footer-heading">Updates from the network</p>
            <div class="mt-3">
              <SubscribeForm compact note="" />
            </div>
          </div>
        )}
      </div>
    </div>

    <div class="footer-rule mt-12 pt-6">
      <p class="footer-small">
        &copy; {currentYear} Theory, Model, Measurement Network. All rights reserved.
      </p>
    </div>
  </div>
</footer>
