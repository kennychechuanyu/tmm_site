---
interface NavItem {
  label: string;
  href: string;
}

interface Props {
  items: NavItem[];
}

const { items } = Astro.props;
const currentPath = Astro.url.pathname;
---

<ul class="flex items-center">
  {items.map((item) => {
    const isActive = currentPath === item.href ||
      (item.href !== "/" && currentPath.startsWith(item.href));

    return (
      <li>
        <a
          href={item.href}
          class="nav-link"
          aria-current={isActive ? "page" : undefined}
        >
          {item.label}
        </a>
      </li>
    );
  })}
</ul>
