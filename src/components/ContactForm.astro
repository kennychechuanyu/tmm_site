---
interface Props {
  formspreeId?: string;
}

import { formAction } from "../utils/forms";
const { formspreeId = "YOUR_FORM_ID" } = Astro.props;
---

<form
  action={formAction(formspreeId)}
  method="POST"
  class="space-y-6"
  data-site-form="contact"
  data-success="contact-success"
>
  <input type="hidden" name="form" value="contact" />
  <div class="grid gap-6 sm:grid-cols-2">
    <div>
      <label for="name" class="label">Name</label>
      <input
        type="text"
        id="name"
        name="name"
        required
        class="input"
        placeholder="Your name"
      />
    </div>

    <div>
      <label for="email" class="label">Email</label>
      <input
        type="email"
        id="email"
        name="email"
        required
        class="input"
        placeholder="you@example.com"
      />
    </div>
  </div>

  <div>
    <label for="subject" class="label">Subject</label>
    <select
      id="subject"
      name="subject"
      required
      class="input"
    >
      <option value="">Select a topic</option>
      <option value="general">General Inquiry</option>
      <option value="membership">Membership</option>
      <option value="events">Events</option>
      <option value="collaboration">Collaboration</option>
      <option value="other">Other</option>
    </select>
  </div>

  <div>
    <label for="message" class="label">Message</label>
    <textarea
      id="message"
      name="message"
      rows="5"
      required
      class="input resize-none"
      placeholder="Your message..."
    ></textarea>
  </div>

  <!-- Honeypot: hidden from people, filled in by bots -->
  <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" style="display:none" />

  <div>
    <button type="submit" class="btn-primary w-full sm:w-auto">
      Send Message
    </button>
  </div>
</form>

<div id="contact-success" class="hidden rounded-lg border border-slate-200 bg-slate-50 p-6 dark:border-slate-800 dark:bg-slate-900/40">
  <p class="font-serif text-lg text-slate-900 dark:text-white">Thank you. Your message has been sent.</p>
  <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">We reply from tmm.psych@outlook.com, usually within a few days.</p>
</div>
