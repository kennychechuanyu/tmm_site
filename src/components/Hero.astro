---
interface Props {
  subtitle: string;
  description: string;
  primaryCTA?: {
    label: string;
    href: string;
  };
  secondaryCTA?: {
    label: string;
    href: string;
  };
}

const { subtitle, description, primaryCTA, secondaryCTA } = Astro.props;
---

<section class="hero">
  <div class="container-wide">
    <p class="hero-lead">A Network for</p>

    <h1 class="hero-title">
      <span>Theory,</span>
      <span>Model,</span>
      <span>Measurement.</span>
    </h1>

    <div class="hero-body">
      <p class="hero-sub">{subtitle}</p>

      <div class="hero-main">
        <p class="hero-text" set:html={description}></p>

        {(primaryCTA || secondaryCTA) && (
          <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4">
            {primaryCTA && (
              <a href={primaryCTA.href} class="btn-primary">
                {primaryCTA.label}
              </a>
            )}
            {secondaryCTA && (
              <a href={secondaryCTA.href} class="text-link">
                {secondaryCTA.label}
              </a>
            )}
          </div>
        )}
      </div>
    </div>
  </div>
</section>
