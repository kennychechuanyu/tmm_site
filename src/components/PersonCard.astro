---
import { smallPhoto } from "../utils/photos";

interface Props {
  name: string;
  institution?: string;
  role?: string;
  image?: string;
  email?: string;
  website?: string;
  website2?: string;
  bio?: string;
  photoCredit?: string;
  photoCreditUrl?: string;
  links?: { label: string; url: string }[];
  tag?: string;
}

const { name, institution, role, image, email, website, website2, bio, photoCredit, photoCreditUrl, links, tag } = Astro.props;
const photo = smallPhoto(image);

const initials = name
  .replace(/\s*\(.*?\)\s*/g, " ")
  .trim()
  .split(" ")
  .map((n) => n[0])
  .join("")
  .slice(0, 2)
  .toUpperCase();

const slug = name.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
const dialogId = `profile-${slug}`;
const labLink = website2 ? website : null;

const extraLinks = links ?? [];
const escapeAttr = (s: string) =>
  s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
const extraLinksHtml = extraLinks
  .map(
    (l) =>
      `<a href="${escapeAttr(l.url)}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 font-sans text-sm font-semibold text-accent-800 underline decoration-accent-800/30 underline-offset-[3px] hover:decoration-accent-800 dark:text-accent-300 dark:decoration-accent-300/40">${escapeAttr(l.label)}</a>`
  )
  .join("");
---

<div class="person-cell">
<button
  type="button"
  data-profile-open={dialogId}
  aria-expanded="false"
  class="profile-trigger group relative flex w-full flex-col items-center text-center focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-600 focus-visible:ring-offset-4 focus-visible:ring-offset-white dark:focus-visible:ring-offset-slate-950"
>
  <div
    data-card-portrait
    class:list={[
      "relative aspect-[4/5] w-40 overflow-hidden rounded-[3px]",
      image ? "bg-slate-100 dark:bg-slate-800" : "border border-dashed border-slate-300 dark:border-slate-600",
    ]}
  >
    {image ? (
      <Fragment>
        <img
          src={photo}
          alt={name}
          loading="lazy"
          class="h-full w-full object-cover object-[center_30%] transition-opacity duration-300 group-aria-expanded:opacity-0"
        />
        <span aria-hidden="true" class="pointer-events-none absolute inset-0 flex items-center justify-center font-serif text-2xl text-slate-300 opacity-0 transition-opacity duration-300 group-aria-expanded:opacity-100 dark:text-slate-600">{initials}</span>
      </Fragment>
    ) : (
      <div class="flex h-full w-full items-center justify-center">
        <span class="font-serif text-2xl text-slate-300 dark:text-slate-600">{initials}</span>
      </div>
    )}
  </div>

  {tag && (
    <p class="mt-4 font-sans text-sm font-semibold text-slate-600 dark:text-slate-400">{tag}</p>
  )}
  <h3 class:list={[tag ? "mt-1" : "mt-4", "font-serif text-lg leading-snug text-slate-900 decoration-1 underline-offset-4 group-hover:underline dark:text-white"]}>{name}</h3>
  {institution && <p class="mt-1 font-sans text-[0.9375rem] font-semibold leading-snug text-slate-700 dark:text-slate-300">{institution}</p>}
  {role && <p class="mt-0.5 font-sans text-sm leading-snug text-slate-500 dark:text-slate-400">{role}</p>}

  <span class="mt-3 inline-flex items-center gap-1 font-sans text-sm font-semibold text-accent-800 dark:text-accent-300">
    {bio ? "View profile" : "Details"}
    <svg class="h-3.5 w-3.5 transition-transform duration-200 group-aria-expanded:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
    </svg>
  </span>
</button>

<template id={dialogId} data-profile-template data-slug={slug}>
  <div class="relative border-y border-slate-900/15 py-10 dark:border-slate-100/15 md:py-12">
    <button type="button" data-profile-close aria-label="Close profile" class="absolute right-0 top-6 flex h-9 w-9 items-center justify-center rounded-md text-slate-500 transition-colors hover:bg-slate-100 hover:text-slate-800 dark:hover:bg-slate-800 dark:hover:text-slate-200">
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </button>

    <div class="grid items-start gap-8 text-left md:grid-cols-[auto_1fr] md:gap-12">
      <div>
        <div data-panel-portrait class:list={[
          "aspect-[4/5] w-44 overflow-hidden rounded-[3px] md:w-56",
          image ? "bg-slate-100 dark:bg-slate-800" : "border border-dashed border-slate-300 dark:border-slate-600",
        ]}>
          {image ? (
            <img src={photo} alt={name} loading="lazy" class="h-full w-full object-cover object-[center_30%]" />
          ) : (
            <div class="flex h-full w-full items-center justify-center">
              <span class="font-serif text-3xl text-slate-300 dark:text-slate-600">{initials}</span>
            </div>
          )}
        </div>
        {image && photoCredit && (
          <p class="mt-2.5 w-44 font-sans text-xs leading-relaxed text-slate-500 dark:text-slate-400 md:w-56">
            Photo:{" "}
            {photoCreditUrl ? (
              <a href={photoCreditUrl} target="_blank" rel="noopener noreferrer" class="underline decoration-slate-300 underline-offset-2 hover:text-slate-800 dark:decoration-slate-600 dark:hover:text-slate-200">{photoCredit}</a>
            ) : (
              photoCredit
            )}
          </p>
        )}
      </div>

      <div class="min-w-0">
        <h3 class="pr-12 font-serif text-2xl leading-tight text-slate-900 dark:text-white md:text-3xl">{name}</h3>
        {institution && <p class="mt-2 font-sans text-base font-semibold text-slate-700 dark:text-slate-300">{institution}</p>}
        {role && <p class="mt-0.5 font-sans text-[0.9375rem] text-slate-500 dark:text-slate-400">{role}</p>}

        {bio ? (
          <p class="mt-6 max-w-[65ch] text-pretty text-[1.0625rem] leading-[1.75] text-slate-700 dark:text-slate-300">{bio}</p>
        ) : (
          <p class="mt-6 font-sans text-[0.9375rem] italic leading-relaxed text-slate-500 dark:text-slate-400">Profile details coming soon.</p>
        )}

        {(email || website || website2 || extraLinks.length > 0) && (
          <div class="mt-7 flex max-w-[65ch] flex-wrap items-center gap-x-6 gap-y-3 border-t border-slate-900/15 pt-5 dark:border-slate-100/15">
            {email && (
              <a href={`mailto:${email}`} class="font-sans text-sm text-slate-600 underline decoration-slate-300 underline-offset-[3px] hover:text-slate-900 dark:text-slate-400 dark:decoration-slate-600 dark:hover:text-slate-100">
                {email}
              </a>
            )}
            {website && (
              <a href={website} target="_blank" rel="noopener noreferrer" class="font-sans text-sm font-semibold text-accent-800 underline decoration-accent-800/30 underline-offset-[3px] hover:decoration-accent-800 dark:text-accent-300 dark:decoration-accent-300/40">
                {labLink ? "Lab page" : "Personal page"}
              </a>
            )}
            {website2 && (
              <a href={website2} target="_blank" rel="noopener noreferrer" class="font-sans text-sm font-semibold text-accent-800 underline decoration-accent-800/30 underline-offset-[3px] hover:decoration-accent-800 dark:text-accent-300 dark:decoration-accent-300/40">
                Personal page
              </a>
            )}
            {extraLinks.length > 0 && <Fragment set:html={extraLinksHtml} />}
          </div>
        )}
      </div>
    </div>
  </div>
</template>
</div>

<script>
  if (!(window as any).__tmmProfilePanels) {
    (window as any).__tmmProfilePanels = true;

    type PanelState = { panel: HTMLElement; openId: string | null; opener: HTMLElement | null };
    const state = new WeakMap<HTMLElement, PanelState>();
    let activeGrid: HTMLElement | null = null;
    let flying: HTMLElement | null = null;
    const reduce = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    function ensure(grid: HTMLElement): PanelState {
      let s = state.get(grid);
      if (!s) {
        const panel = document.createElement("div");
        panel.className = "profile-panel";
        panel.style.gridColumn = "1 / -1";
        panel.tabIndex = -1;
        s = { panel, openId: null, opener: null };
        state.set(grid, s);
      }
      return s;
    }

    function placeAfterRow(grid: HTMLElement, cell: HTMLElement, panel: HTMLElement) {
      const cells = [...grid.children].filter((c) => c.classList?.contains("person-cell")) as HTMLElement[];
      const top = cell.offsetTop;
      const rowLast = cells.filter((c) => c.offsetTop === top).pop() ?? cell;
      grid.insertBefore(panel, rowLast.nextSibling);
    }

    function flyPortrait(fromImg: HTMLImageElement | null, toImg: HTMLImageElement | null) {
      if (flying) {
        flying.remove();
        flying = null;
      }
      if (!fromImg || !toImg) return;
      if (reduce()) return;
      const a = fromImg.getBoundingClientRect();
      const b = toImg.getBoundingClientRect();
      if (!a.width || !b.width) return;

      const clone = fromImg.cloneNode(true) as HTMLElement;
      clone.removeAttribute("loading");
      Object.assign(clone.style, {
        position: "absolute",
        left: `${a.left + window.scrollX}px`,
        top: `${a.top + window.scrollY}px`,
        width: `${a.width}px`,
        height: `${a.height}px`,
        margin: "0",
        zIndex: "40",
        borderRadius: "3px",
        objectFit: "cover",
        objectPosition: "center 30%",
        opacity: "1",
        transform: "none",
        transformOrigin: "top left",
        transition: "none",
        pointerEvents: "none",
      });
      document.body.appendChild(clone);
      flying = clone;
      toImg.style.opacity = "0";

      const anim = clone.animate(
        [
          { transform: "translate(0, 0) scale(1)" },
          { transform: `translate(${b.left - a.left}px, ${b.top - a.top}px) scale(${b.width / a.width})` },
        ],
        { duration: 520, easing: "cubic-bezier(0.22, 1, 0.36, 1)" }
      );
      const land = () => {
        toImg.style.opacity = "";
        if (flying === clone) flying = null;
        clone.remove();
      };
      anim.onfinish = land;
      anim.oncancel = land;
    }

    function open(opener: HTMLElement) {
      const cell = opener.closest<HTMLElement>(".person-cell");
      const grid = cell?.parentElement as HTMLElement | null;
      const id = opener.getAttribute("data-profile-open");
      if (!cell || !grid || !id) return;

      const s = ensure(grid);
      if (s.openId === id) {
        close(grid);
        return;
      }
      if (activeGrid && activeGrid !== grid) close(activeGrid, true);

      const tpl = document.getElementById(id) as HTMLTemplateElement | null;
      if (!tpl) return;

      const switching = !!s.openId;
      if (s.panel.parentElement) {
        s.panel.style.height = "auto";
        s.panel.remove();
      }
      s.panel.innerHTML = "";
      s.panel.appendChild(tpl.content.cloneNode(true));
      placeAfterRow(grid, cell, s.panel);

      grid.querySelectorAll("[data-profile-open]").forEach((b) => b.setAttribute("aria-expanded", "false"));
      opener.setAttribute("aria-expanded", "true");
      s.openId = id;
      s.opener = opener;
      activeGrid = grid;

      const slug = tpl.getAttribute("data-slug");
      if (slug) history.replaceState(null, "", `#${slug}`);

      if (reduce()) {
        s.panel.style.height = "auto";
      } else {
        const h = s.panel.scrollHeight;
        s.panel.style.height = switching ? s.panel.style.height || "0px" : "0px";
        s.panel.getBoundingClientRect();
        s.panel.style.height = `${h}px`;
        const onEnd = (e: TransitionEvent) => {
          if (e.propertyName === "height") {
            s.panel.style.height = "auto";
            s.panel.removeEventListener("transitionend", onEnd);
          }
        };
        s.panel.addEventListener("transitionend", onEnd);
      }

      flyPortrait(
        cell.querySelector<HTMLImageElement>("[data-card-portrait] img"),
        s.panel.querySelector<HTMLImageElement>("[data-panel-portrait] img")
      );

      requestAnimationFrame(() => {
        s.panel.focus({ preventScroll: true });
        s.panel.scrollIntoView({ behavior: reduce() ? "auto" : "smooth", block: "nearest" });
      });
    }

    function close(grid: HTMLElement, instant = false) {
      const s = state.get(grid);
      if (!s || !s.openId) return;
      const opener = s.opener;
      const cell = opener?.closest<HTMLElement>(".person-cell") ?? null;
      grid.querySelectorAll("[data-profile-open]").forEach((b) => b.setAttribute("aria-expanded", "false"));
      s.openId = null;
      s.opener = null;
      if (activeGrid === grid) activeGrid = null;
      if (location.hash) history.replaceState(null, "", location.pathname + location.search);

      if (!instant && cell) {
        const panelImg = s.panel.querySelector<HTMLImageElement>("[data-panel-portrait] img");
        const cardImg = cell.querySelector<HTMLImageElement>("[data-card-portrait] img");
        flyPortrait(panelImg, cardImg);
        if (panelImg) panelImg.style.opacity = "0";
      }

      const finish = () => {
        s.panel.remove();
        s.panel.innerHTML = "";
        s.panel.style.height = "";
      };
      if (instant || reduce()) {
        finish();
      } else {
        s.panel.style.height = `${s.panel.offsetHeight}px`;
        s.panel.getBoundingClientRect();
        s.panel.style.height = "0px";
        let done = false;
        const onEnd = (e: TransitionEvent) => {
          if (e.propertyName === "height" && !done) {
            done = true;
            s.panel.removeEventListener("transitionend", onEnd);
            finish();
          }
        };
        s.panel.addEventListener("transitionend", onEnd);
        setTimeout(() => {
          if (!done) {
            done = true;
            finish();
          }
        }, 600);
      }
      opener?.focus({ preventScroll: true });
    }

    document.addEventListener("click", (e) => {
      const t = e.target as HTMLElement;
      const opener = t.closest<HTMLElement>("[data-profile-open]");
      if (opener) {
        open(opener);
        return;
      }
      const closer = t.closest("[data-profile-close]");
      if (closer) {
        const grid = closer.closest(".profile-panel")?.parentElement as HTMLElement | null;
        if (grid) close(grid);
      }
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && activeGrid) close(activeGrid);
    });

    let rt: number;
    window.addEventListener("resize", () => {
      clearTimeout(rt);
      rt = window.setTimeout(() => {
        if (!activeGrid) return;
        const s = state.get(activeGrid);
        const cell = s?.opener?.closest<HTMLElement>(".person-cell");
        if (!s?.openId || !cell) return;
        s.panel.style.height = "auto";
        s.panel.remove();
        placeAfterRow(activeGrid, cell, s.panel);
      }, 150);
    });

    function openFromHash() {
      const slug = location.hash.slice(1);
      if (!slug) return;
      const tpl = document.querySelector<HTMLTemplateElement>(`template[data-slug="${CSS.escape(slug)}"]`);
      const opener = tpl?.closest(".person-cell")?.querySelector<HTMLElement>("[data-profile-open]");
      if (opener) requestAnimationFrame(() => open(opener));
    }
    openFromHash();
    window.addEventListener("hashchange", openFromHash);
    document.addEventListener("astro:after-swap", () => {
      activeGrid = null;
      openFromHash();
    });
  }
</script>
