---
/**
 * PersonCard — profile card whose bio opens as an inline expanding panel:
 * the grid parts below the clicked card's row and a full-width editorial
 * panel unfolds in-flow (no overlay). Used on the People and Event pages.
 *
 * Each card ships its panel content in a <template>; a single shared panel
 * element per grid is filled from it and inserted after the clicked row.
 * Deep-linkable via #<slug>. Esc, ×, or a second click closes it.
 */
interface Props {
  name: string;
  institution?: string;
  role?: string;
  image?: string;
  email?: string;
  website?: string;
  website2?: string;
  bio?: string;
  /** Entrance-stagger delay in ms (used with the .stagger-grid utility). */
  stagger?: number;
}

const { name, institution, role, image, email, website, website2, bio, stagger } = Astro.props;

const initials = name
  .replace(/\s*\(.*?\)\s*/g, " ")
  .trim()
  .split(" ")
  .map((n) => n[0])
  .join("")
  .slice(0, 2)
  .toUpperCase();

const slug = name.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
const dialogId = `profile-${slug}`;
const labLink = website2 ? website : null; // primary website acts as lab page if a 2nd exists
---

<!-- One grid cell: card + its panel template (single child keeps grid counts correct) -->
<div class="person-cell" style={typeof stagger === "number" ? `transition-delay: ${stagger}ms` : undefined}>
<!-- Card (whole card toggles the inline profile panel) -->
<button
  type="button"
  data-profile-open={dialogId}
  aria-expanded="false"
  class="profile-trigger group relative flex w-full flex-col items-center pt-8 text-center focus:outline-none focus-visible:ring-2 focus-visible:ring-salmon-400 focus-visible:ring-offset-4 focus-visible:ring-offset-white dark:focus-visible:ring-offset-slate-950 rounded-md"
>
  <!-- Top accent rule -->
  <span aria-hidden="true" class="absolute inset-x-0 top-0 h-px bg-slate-200 dark:bg-slate-700"></span>
  <span aria-hidden="true" class="absolute inset-x-0 top-0 h-[2px] w-0 bg-salmon-500 transition-[width] duration-700 ease-out group-hover:w-full group-aria-expanded:w-full dark:bg-salmon-400"></span>

  <!-- Portrait: frameless 4:5 on a soft shadow; whitespace does the framing -->
  <div class="aspect-[4/5] w-40 overflow-hidden rounded-xl bg-slate-100 shadow-[0_14px_36px_-14px_rgba(15,23,42,0.3)] transition-shadow duration-500 group-hover:shadow-[0_20px_48px_-16px_rgba(240,106,90,0.4)] dark:bg-slate-800 dark:shadow-[0_14px_36px_-14px_rgba(0,0,0,0.65)] dark:group-hover:shadow-[0_20px_48px_-16px_rgba(240,106,90,0.3)]">
    {image ? (
      <img
        src={image}
        alt={name}
        loading="lazy"
        class="h-full w-full object-cover object-[center_30%] transition-transform duration-700 ease-out group-hover:scale-[1.04]"
      />
    ) : (
      <div class="flex h-full w-full items-center justify-center">
        <span class="font-serif text-2xl text-slate-300 dark:text-slate-600">{initials}</span>
      </div>
    )}
  </div>

  <h3 class="mt-6 font-serif text-lg text-slate-900 dark:text-white" style="letter-spacing: -0.01em;">{name}</h3>
  <span aria-hidden="true" class="mx-auto mt-2.5 block h-px w-6 bg-salmon-400/60"></span>
  {institution && <p class="mt-2.5 text-sm font-medium text-navy-600 dark:text-navy-400">{institution}</p>}
  {role && <p class="mt-1 font-serif text-xs italic text-slate-500 dark:text-slate-400">{role}</p>}

  <!-- Affordance -->
  <span class="mt-4 inline-flex items-center gap-1.5 font-sans text-[10px] font-semibold uppercase text-slate-400 transition-colors duration-300 group-hover:text-salmon-600 group-aria-expanded:text-salmon-600 dark:text-slate-500 dark:group-hover:text-salmon-400 dark:group-aria-expanded:text-salmon-400" style="letter-spacing: 0.2em;">
    {bio ? "View profile" : "Details"}
    <svg class="h-3 w-3 transition-transform duration-300 group-hover:translate-y-0.5 group-aria-expanded:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v13m0 0 5.5-5.5M12 18l-5.5-5.5" />
    </svg>
  </span>
</button>

<!-- Panel content (cloned into the shared inline panel on open) -->
<template id={dialogId} data-profile-template data-slug={slug}>
  <div class="relative border-y border-slate-200 py-10 dark:border-slate-800 md:py-12">
    <!-- Close -->
    <button type="button" data-profile-close aria-label="Close profile" class="absolute right-0 top-6 flex h-9 w-9 items-center justify-center rounded-full text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-700 dark:hover:bg-slate-800 dark:hover:text-slate-200">
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </button>

    <div class="grid items-start gap-8 md:grid-cols-[auto_1fr] md:gap-12">
      <!-- Large portrait -->
      <div class="aspect-[4/5] w-44 overflow-hidden rounded-xl bg-slate-100 shadow-[0_16px_40px_-16px_rgba(15,23,42,0.35)] dark:bg-slate-800 dark:shadow-[0_16px_40px_-16px_rgba(0,0,0,0.65)] md:w-56">
        {image ? (
          <img src={image} alt={name} loading="lazy" class="h-full w-full object-cover object-[center_30%]" />
        ) : (
          <div class="flex h-full w-full items-center justify-center">
            <span class="font-serif text-3xl text-slate-300 dark:text-slate-600">{initials}</span>
          </div>
        )}
      </div>

      <!-- Text column -->
      <div class="min-w-0">
        <h3 class="pr-12 font-serif text-2xl leading-tight text-slate-900 dark:text-white md:text-3xl">{name}</h3>
        <span aria-hidden="true" class="mt-3 block h-px w-8 bg-salmon-400/70"></span>
        {institution && <p class="mt-3 text-sm font-medium text-navy-600 dark:text-navy-400">{institution}</p>}
        {role && <p class="mt-1 font-serif text-sm italic text-slate-500 dark:text-slate-400">{role}</p>}

        {bio ? (
          <p class="mt-6 max-w-[65ch] text-pretty font-sans text-[15px] leading-[1.8] text-slate-600 dark:text-slate-300">{bio}</p>
        ) : (
          <p class="mt-6 font-sans text-sm italic leading-relaxed text-slate-500 dark:text-slate-400">Profile details coming soon.</p>
        )}

        {(email || website || website2) && (
          <div class="mt-7 flex max-w-[65ch] flex-wrap items-center gap-x-6 gap-y-3 border-t border-slate-200 pt-5 dark:border-slate-700">
            {email && (
              <a href={`mailto:${email}`} class="inline-flex items-center gap-2 font-mono text-xs text-slate-500 transition-colors hover:text-salmon-600 dark:text-slate-400 dark:hover:text-salmon-400">
                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l9 6 9-6M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                {email}
              </a>
            )}
            {website && (
              <a href={website} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 font-sans text-xs font-medium text-navy-600 transition-colors hover:text-salmon-600 dark:text-navy-400 dark:hover:text-salmon-400">
                {labLink ? "Lab page" : "Personal page"}
                <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" /></svg>
              </a>
            )}
            {website2 && (
              <a href={website2} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 font-sans text-xs font-medium text-navy-600 transition-colors hover:text-salmon-600 dark:text-navy-400 dark:hover:text-salmon-400">
                Personal page
                <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" /></svg>
              </a>
            )}
          </div>
        )}
      </div>
    </div>
  </div>
</template>
</div>

<script>
  // Inline profile panels: one shared panel per grid, inserted after the
  // clicked card's row so the grid visibly "parts" to reveal the bio.
  if (!(window as any).__tmmProfilePanels) {
    (window as any).__tmmProfilePanels = true;

    type PanelState = { panel: HTMLElement; openId: string | null; opener: HTMLElement | null };
    const state = new WeakMap<HTMLElement, PanelState>();
    let activeGrid: HTMLElement | null = null;
    const reduce = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    function ensure(grid: HTMLElement): PanelState {
      let s = state.get(grid);
      if (!s) {
        const panel = document.createElement("div");
        panel.className = "profile-panel";
        panel.style.gridColumn = "1 / -1";
        panel.tabIndex = -1;
        s = { panel, openId: null, opener: null };
        state.set(grid, s);
      }
      return s;
    }

    function placeAfterRow(grid: HTMLElement, cell: HTMLElement, panel: HTMLElement) {
      const cells = [...grid.children].filter((c) => c.classList?.contains("person-cell")) as HTMLElement[];
      const top = cell.offsetTop;
      const rowLast = cells.filter((c) => c.offsetTop === top).pop() ?? cell;
      grid.insertBefore(panel, rowLast.nextSibling);
    }

    function open(opener: HTMLElement) {
      const cell = opener.closest<HTMLElement>(".person-cell");
      const grid = cell?.parentElement as HTMLElement | null;
      const id = opener.getAttribute("data-profile-open");
      if (!cell || !grid || !id) return;

      const s = ensure(grid);
      if (s.openId === id) {
        close(grid);
        return;
      }
      if (activeGrid && activeGrid !== grid) close(activeGrid, true);

      const tpl = document.getElementById(id) as HTMLTemplateElement | null;
      if (!tpl) return;

      const switching = !!s.openId;
      // Detach before measuring so row offsets are panel-free.
      if (s.panel.parentElement) {
        s.panel.style.height = "auto";
        s.panel.remove();
      }
      s.panel.innerHTML = "";
      s.panel.appendChild(tpl.content.cloneNode(true));
      placeAfterRow(grid, cell, s.panel);

      grid.querySelectorAll("[data-profile-open]").forEach((b) => b.setAttribute("aria-expanded", "false"));
      opener.setAttribute("aria-expanded", "true");
      s.openId = id;
      s.opener = opener;
      activeGrid = grid;

      const slug = tpl.getAttribute("data-slug");
      if (slug) history.replaceState(null, "", `#${slug}`);

      if (reduce()) {
        s.panel.style.height = "auto";
      } else {
        const h = s.panel.scrollHeight;
        s.panel.style.height = switching ? s.panel.style.height || "0px" : "0px";
        s.panel.getBoundingClientRect(); // reflow so the height transition runs
        s.panel.style.height = `${h}px`;
        const onEnd = (e: TransitionEvent) => {
          if (e.propertyName === "height") {
            s.panel.style.height = "auto";
            s.panel.removeEventListener("transitionend", onEnd);
          }
        };
        s.panel.addEventListener("transitionend", onEnd);
      }

      requestAnimationFrame(() => {
        s.panel.focus({ preventScroll: true });
        s.panel.scrollIntoView({ behavior: reduce() ? "auto" : "smooth", block: "nearest" });
      });
    }

    function close(grid: HTMLElement, instant = false) {
      const s = state.get(grid);
      if (!s || !s.openId) return;
      const opener = s.opener;
      grid.querySelectorAll("[data-profile-open]").forEach((b) => b.setAttribute("aria-expanded", "false"));
      s.openId = null;
      s.opener = null;
      if (activeGrid === grid) activeGrid = null;
      if (location.hash) history.replaceState(null, "", location.pathname + location.search);

      const finish = () => {
        s.panel.remove();
        s.panel.innerHTML = "";
        s.panel.style.height = "";
      };
      if (instant || reduce()) {
        finish();
      } else {
        s.panel.style.height = `${s.panel.offsetHeight}px`;
        s.panel.getBoundingClientRect();
        s.panel.style.height = "0px";
        let done = false;
        const onEnd = (e: TransitionEvent) => {
          if (e.propertyName === "height" && !done) {
            done = true;
            s.panel.removeEventListener("transitionend", onEnd);
            finish();
          }
        };
        s.panel.addEventListener("transitionend", onEnd);
        setTimeout(() => {
          if (!done) {
            done = true;
            finish();
          }
        }, 600);
      }
      opener?.focus({ preventScroll: true });
    }

    document.addEventListener("click", (e) => {
      const t = e.target as HTMLElement;
      const opener = t.closest<HTMLElement>("[data-profile-open]");
      if (opener) {
        open(opener);
        return;
      }
      const closer = t.closest("[data-profile-close]");
      if (closer) {
        const grid = closer.closest(".profile-panel")?.parentElement as HTMLElement | null;
        if (grid) close(grid);
      }
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && activeGrid) close(activeGrid);
    });

    let rt: number;
    window.addEventListener("resize", () => {
      clearTimeout(rt);
      rt = window.setTimeout(() => {
        if (!activeGrid) return;
        const s = state.get(activeGrid);
        const cell = s?.opener?.closest<HTMLElement>(".person-cell");
        if (!s?.openId || !cell) return;
        s.panel.style.height = "auto";
        s.panel.remove();
        placeAfterRow(activeGrid, cell, s.panel);
      }, 150);
    });

    // Deep link: /people#kenny-yu opens that profile.
    function openFromHash() {
      const slug = location.hash.slice(1);
      if (!slug) return;
      const tpl = document.querySelector<HTMLTemplateElement>(`template[data-slug="${CSS.escape(slug)}"]`);
      const opener = tpl?.closest(".person-cell")?.querySelector<HTMLElement>("[data-profile-open]");
      if (opener) requestAnimationFrame(() => open(opener));
    }
    openFromHash();
    document.addEventListener("astro:after-swap", () => {
      activeGrid = null;
      openFromHash();
    });
  }
</script>
