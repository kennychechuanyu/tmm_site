---
import ChapterHeader from "./ChapterHeader.astro";

interface Props {
  title?: string;
  subtitle?: string;
  background?: "white" | "gray" | "navy";
  compactTop?: boolean;
  id?: string;
  class?: string;
}

const {
  title,
  subtitle,
  background = "white",
  compactTop = false,
  id,
  class: className,
} = Astro.props;

const bgClasses = {
  white: "bg-white dark:bg-slate-950",
  gray: "bg-slate-50 dark:bg-slate-900/50",
  navy: "bg-accent-50 dark:bg-accent-950",
};
---

<section id={id} class:list={["section", compactTop && "!pt-8 md:!pt-10", bgClasses[background], className]}>
  <div class="container-wide">
    {title && (
      <div class="mb-8 md:mb-10">
        <ChapterHeader title={title} />
        {subtitle && (
          <p class="mt-4 max-w-3xl text-lg text-slate-600 dark:text-slate-400">
            {subtitle}
          </p>
        )}
      </div>
    )}

    <slot />
  </div>
</section>
