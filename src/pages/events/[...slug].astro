---
import PageLayout from "../../layouts/PageLayout.astro";
import Section from "../../components/Section.astro";
import Button from "../../components/Button.astro";
import PersonCard from "../../components/PersonCard.astro";
import { toInstants, hasEnded } from "../../utils/eventTime";
import { smallPhoto } from "../../utils/photos";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const events = await getCollection("events");
  return events.map((event) => ({
    params: { slug: event.slug },
    props: { event },
  }));
}

const { event } = Astro.props;
const { Content } = await render(event);
const hasBody = (event.body ?? "").trim().length > 0;
const isPast = hasEnded(event.data);
const attendance = isPast ? [] : event.data.attendance ?? [];

const eventTypeLabel =
  event.data.type.charAt(0).toUpperCase() + event.data.type.slice(1);
const eyebrow = event.data.eyebrow ?? eventTypeLabel;

const d = event.data.date;
const datePart = (opts: Intl.DateTimeFormatOptions) =>
  d ? d.toLocaleDateString("en-US", { ...opts, timeZone: "UTC" }) : "";
const dateParts = d
  ? {
      day: datePart({ day: "numeric" }),
      month: datePart({ month: "long" }),
      year: datePart({ year: "numeric" }),
      weekday: datePart({ weekday: "long" }),
    }
  : null;

const talks = event.data.talks ?? [];
const speakers = event.data.speakers ?? [];
const panelists = event.data.panelists ?? [];
const moderators = event.data.moderators ?? [];
const slugOf = (name: string) =>
  name.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");

const speakerByName = (name: string) => speakers.find((s) => s.name === name);
const panelistByName = (name: string) => panelists.find((p) => p.name === name);
const talkBySpeaker = (name: string) => talks.find((t) => t.speaker === name);

const rows =
  (event.data.programme?.length ?? 0) > 0
    ? event.data.programme!
    : talks.map((t) => ({ time: undefined, label: undefined, talk: t.speaker }));

const byLastName = (a: { name: string }, b: { name: string }) =>
  a.name.split(" ").pop()!.localeCompare(b.name.split(" ").pop()!);

const portraitsFirst = <T extends { photo?: string }>(people: T[]) => [
  ...people.filter((p) => p.photo),
  ...people.filter((p) => !p.photo),
];

const tz = event.data.timezone;
const instantsOf = (raw?: string) => toInstants(raw, d, tz);
const startLabel = (raw?: string) => raw?.match(/\d{1,2}:\d{2}/)?.[0] ?? raw;
const eventSpan = instantsOf(event.data.time);
const aboutParas = (event.data.about ?? "").split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);

const wallClock = (iso?: string) =>
  iso
    ? new Intl.DateTimeFormat("en-GB", { timeZone: tz, hour: "2-digit", minute: "2-digit", hourCycle: "h23" }).format(new Date(iso))
    : undefined;
const zoneAbbr = eventSpan
  ? new Intl.DateTimeFormat("en-GB", { timeZone: tz, hour: "numeric", timeZoneName: "short" })
      .formatToParts(new Date(eventSpan.start))
      .find((p) => p.type === "timeZoneName")?.value
  : undefined;
const sessionFormat = event.data.sessionFormat;
const timeline = rows
  .map((row) => {
    const talk = row.talk ? talkBySpeaker(row.talk) : undefined;
    const raw = talk?.time ?? row.time;
    return { row, talk, raw, at: instantsOf(raw) };
  })
  .map((r, i, all) => {
    const nextStart = all.slice(i + 1).find((x) => x.at?.start)?.at?.start;
    const end = r.at?.end ?? nextStart ?? eventSpan?.end;
    const minutes =
      r.at?.start && end ? Math.round((new Date(end).getTime() - new Date(r.at.start).getTime()) / 60000) : undefined;
    const label = r.at?.start ? `${wallClock(r.at.start)} – ${wallClock(end)}` : r.raw;
    return { ...r, end, minutes, label };
  });
const icsHref = eventSpan ? `/events/${event.slug}.ics` : undefined;

const assigned = new Set(talks.flatMap((t) => t.panel ?? []));
const unassigned = portraitsFirst(
  panelists.filter((p) => !assigned.has(p.name)).sort(byLastName)
);
const groupedPanels = talks.some((t) => (t.panel?.length ?? 0) > 0);

---

<PageLayout
  title={event.data.title}
  description={event.data.description}
  subtitle={event.data.deck}
  eyebrow={eyebrow}
  image={event.data.ogImage}
  compact
>
  <section class="border-b border-slate-900/10 bg-white dark:border-slate-100/10 dark:bg-slate-950">
    <div class="container-wide py-8 md:py-10">
      <dl class="grid gap-x-10 gap-y-8 sm:grid-cols-2 md:flex md:items-stretch md:gap-0 md:divide-x md:divide-slate-200 dark:md:divide-slate-800">
        <div class="flex flex-col gap-2.5 md:pr-12">
          <dt class="font-sans text-sm font-semibold text-slate-600 dark:text-slate-400">
            When
          </dt>
          <dd>
            {dateParts ? (
              <span class="flex items-baseline gap-3.5" data-local-date={eventSpan?.start} data-tz={tz}>
                <span data-part="day" class="font-serif text-5xl leading-[0.85] tabular-nums text-slate-900 dark:text-slate-100 md:text-6xl">
                  {dateParts.day}
                </span>
                <span class="flex flex-col gap-0.5 font-sans text-sm">
                  <span data-part="month-year" class="font-semibold text-slate-900 dark:text-slate-100">{dateParts.month} {dateParts.year}</span>
                  <span data-part="weekday" class="text-slate-600 dark:text-slate-400">{dateParts.weekday}</span>
                </span>
              </span>
            ) : (
              <span class="font-serif text-lg text-slate-900 dark:text-slate-100">Date to be announced</span>
            )}
          </dd>
        </div>

        {event.data.time && (
          <div class="flex flex-col gap-2.5 md:px-12">
            <dt class="font-sans text-sm font-semibold text-slate-600 dark:text-slate-400">
              Time
            </dt>
            <dd>
              <p class="font-serif text-lg leading-snug text-slate-900 dark:text-slate-100">
                <time
                  datetime={eventSpan?.start}
                  data-local-time
                  data-end={eventSpan?.end}
                  data-tz={tz}
                >{event.data.time}</time>
              </p>
              {event.data.timeNote && !isPast && (
                <p
                  class="mt-2 max-w-[15rem] font-sans text-sm leading-relaxed text-slate-600 dark:text-slate-400"
                  data-local-note
                  data-source={event.data.time}
                  data-at={eventSpan?.start}
                  data-tz={tz}
                >{event.data.timeNote}</p>
              )}
            </dd>
          </div>
        )}

        <div class="flex flex-col gap-2.5 md:px-12">
          <dt class="font-sans text-sm font-semibold text-slate-600 dark:text-slate-400">
            Where
          </dt>
          <dd class="font-serif text-lg leading-snug text-slate-900 dark:text-slate-100">
            {event.data.location}
          </dd>
        </div>

        <div class="flex flex-col items-start justify-center gap-2.5 sm:col-span-2 md:col-span-1 md:ml-auto md:pl-12">
          <dt class="sr-only">Registration</dt>
          <dd class="flex flex-col items-start gap-2.5">
            {isPast ? (
              <>
                <p class="font-serif text-base italic text-slate-700 dark:text-slate-300">
                  This event has taken place.
                </p>
                {event.data.recordingNote && (
                  <p class="max-w-[17rem] font-sans text-sm leading-relaxed text-slate-600 dark:text-slate-400">
                    {event.data.recordingNote}
                  </p>
                )}
              </>
            ) : event.data.registrationUrl ? (
              <Button href={event.data.registrationUrl} external>
                Register Now
              </Button>
            ) : (
              <p class="font-serif text-base italic text-slate-700 dark:text-slate-300">
                Registration opens soon.
              </p>
            )}
            {!isPast && (event.data.admission || icsHref) && (
              <p class="font-sans text-sm text-slate-600 dark:text-slate-400">
                {event.data.admission && <span>{event.data.admission}</span>}
                {event.data.admission && icsHref && (
                  <span aria-hidden="true" class="mx-1.5 text-slate-300 dark:text-slate-600">·</span>
                )}
                {icsHref && (
                  <a
                    href={icsHref}
                    class="font-semibold text-accent-800 underline decoration-accent-800/30 underline-offset-[3px] hover:decoration-accent-800 dark:text-accent-300"
                  >Add to calendar</a>
                )}
              </p>
            )}
          </dd>
        </div>
      </dl>
    </div>
  </section>

  {event.data.about && (
    <Section background="gray" title="About">
      <div class:list={[aboutParas.length === 2 ? "grid gap-y-6 lg:grid-cols-2 lg:gap-x-14" : "lg:columns-2 lg:gap-x-14"]}>
        {aboutParas.map((para, i) => (
          <p
            class:list={[
              aboutParas.length !== 2 && i > 0 && "mt-5",
              "text-pretty text-lg leading-[1.7] text-slate-800 dark:text-slate-200 md:text-[1.25rem] md:leading-[1.65]",
            ]}
            set:html={para}
          />
        ))}
      </div>

      {event.data.questions && event.data.questions.length > 0 && (
        <div class="mt-14 border-t border-slate-900/15 pt-8 dark:border-slate-100/15 md:mt-16 md:pt-10">
          <h3 class="font-sans text-base font-semibold text-slate-900 dark:text-slate-100">Questions in play</h3>

          <div class="mt-6 grid gap-x-12 gap-y-8 md:grid-cols-2">
            {event.data.questions.map((q) => (
              <div class="border-t border-slate-900/15 pt-4 dark:border-slate-100/15">
                <p class="font-sans text-sm font-semibold text-accent-800 dark:text-accent-300">{q.label}</p>
                <p class="mt-2 font-serif text-lg leading-normal text-slate-900 dark:text-slate-100">
                  {q.text}
                </p>
              </div>
            ))}
          </div>
        </div>
      )}

      {event.data.aboutCoda && event.data.aboutCoda.length > 0 && (
        <div class="mt-14 grid gap-x-12 gap-y-8 border-t border-slate-900/15 pt-8 dark:border-slate-100/15 md:mt-16 md:grid-cols-2">
          {event.data.aboutCoda.map((block) => (
            <div>
              <p class="font-sans text-sm font-semibold text-slate-600 dark:text-slate-400">
                {block.label}
              </p>
              <p class="mt-2 max-w-[56ch] text-pretty text-base leading-[1.75] text-slate-700 dark:text-slate-300">
                {block.text}
              </p>
            </div>
          ))}
        </div>
      )}
    </Section>
  )}

  {talks.length > 0 && (
    <Section background="white" title="Programme">
      <table class="mb-16 w-full border-collapse md:mb-20">
        <thead>
          <tr class="border-b border-slate-900/15 dark:border-slate-100/15">
            <th scope="col" class="pb-3 pr-4 text-left font-sans text-sm font-semibold text-slate-600 dark:text-slate-400 md:pr-6">
              Time{zoneAbbr && (
                <span> · <span data-local-zone data-at={eventSpan?.start} data-tz={tz}>{zoneAbbr}</span></span>
              )}
            </th>
            <th scope="col" class="pb-3 text-left font-sans text-sm font-semibold text-slate-600 dark:text-slate-400">
              Programme
            </th>
            <th scope="col" class="hidden pb-3 pl-4 text-right font-sans text-sm font-semibold text-slate-600 dark:text-slate-400 sm:table-cell">
              Length
            </th>
          </tr>
        </thead>
        <tbody>
          {timeline.map(({ row, talk, at, end, minutes, label }) => {
            const idx = talk ? talks.indexOf(talk) : -1;
            const isBreak = !talk && /break/i.test(row.label ?? "");
            return (
              <tr class:list={[
                "border-b border-slate-200 dark:border-slate-700",
                isBreak && "bg-slate-50/80 dark:bg-slate-900/40",
              ]}>
                <td class="whitespace-nowrap py-4 pr-4 align-top font-sans text-sm tabular-nums leading-6 text-slate-600 dark:text-slate-400 md:pr-6">
                  <time
                    datetime={at?.start}
                    data-local-time
                    data-compact
                    data-end={end}
                    data-tz={tz}
                    data-ref={eventSpan?.start}
                  >{label}</time>
                </td>
                <td class="py-4 align-top">
                  <div class="flex items-start gap-3 md:gap-4">
                    <span aria-hidden="true" class="w-4 shrink-0 font-serif text-lg leading-6 text-accent-800 dark:text-accent-300">
                      {talk ? idx + 1 : ""}
                    </span>
                    {talk ? (
                      <div class="min-w-0">
                        <a href={`#session-${idx + 1}`} class="group inline-flex items-baseline gap-2">
                          <span class="font-serif text-base leading-6 text-slate-900 decoration-1 underline-offset-4 group-hover:underline dark:text-slate-100 md:text-lg">
                            {talk.title}
                          </span>
                        </a>
                        <p class="mt-1 font-sans text-sm text-slate-600 dark:text-slate-400">
                          <span class="text-slate-700 dark:text-slate-300">{talk.speaker}</span>
                          {sessionFormat && (
                            <span> · Talk {sessionFormat.talk} min · Discussion {sessionFormat.discussion} min</span>
                          )}
                        </p>
                      </div>
                    ) : (
                      <span class="font-sans text-[0.9375rem] leading-6 text-slate-600 dark:text-slate-400">{row.label}</span>
                    )}
                  </div>
                </td>
                <td class="hidden whitespace-nowrap py-4 pl-4 text-right align-top font-sans text-sm tabular-nums leading-6 text-slate-600 dark:text-slate-400 sm:table-cell">
                  {minutes !== undefined && `${minutes} min`}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>

      <div class="space-y-16 md:space-y-20">
        {talks.map((talk, idx) => {
          const sp = speakerByName(talk.speaker);
          const span = instantsOf(talk.time);
          const sessionLabel = span ? `${wallClock(span.start)} – ${wallClock(span.end)}` : talk.time;
          const members = portraitsFirst(
            (talk.panel ?? []).flatMap((n) => {
              const p = panelistByName(n);
              return p ? [p] : [];
            })
          );
          return (
            <article
              id={`session-${idx + 1}`}
              class="scroll-mt-24 border-t border-slate-900/15 pt-8 dark:border-slate-100/15 lg:grid lg:grid-cols-[11rem_minmax(0,1fr)_11rem] lg:gap-x-14 lg:gap-y-7"
            >
              <div class="flex flex-wrap items-baseline gap-x-5 gap-y-2 lg:row-span-2 lg:flex-col lg:items-start lg:gap-y-3">
                <span class="font-sans text-base font-semibold text-accent-800 dark:text-accent-300">Session {idx + 1}</span>
                {span && (
                  <time
                    datetime={span.start}
                    data-local-time
                    data-end={span.end}
                    data-compact
                    data-tz={tz}
                    data-ref={eventSpan?.start}
                    class="font-sans text-sm tabular-nums text-slate-600 dark:text-slate-400"
                  >{sessionLabel}</time>
                )}
                {sessionFormat && (
                  <span class="font-sans text-sm text-slate-600 dark:text-slate-400">
                    Talk {sessionFormat.talk} min<span class="lg:hidden"> · </span><br class="hidden lg:block" />Discussion {sessionFormat.discussion} min
                  </span>
                )}
              </div>

              <h3 class="mt-4 text-pretty font-serif text-2xl leading-[1.25] text-slate-900 dark:text-white md:text-3xl lg:col-span-2 lg:mt-0">
                {talk.title}
              </h3>
              <p class="mt-5 text-pretty text-[1.0625rem] leading-[1.7] text-slate-800 dark:text-slate-200 md:text-lg md:leading-[1.7] lg:mt-0">
                {talk.abstract}
              </p>
              {sp && (
                <div class="mt-10 w-full lg:mt-0 lg:w-44">
                  <PersonCard
                    name={sp.name}
                    institution={sp.institution}
                    role={sp.role}
                    image={sp.photo}
                    photoCredit={sp.photoCredit}
                    photoCreditUrl={sp.photoCreditUrl}
                    website={sp.website}
                    links={sp.links}
                    bio={sp.bio}
                    tag="Speaker"
                  />
                </div>
              )}

              {members.length > 0 && (
                <div class="mt-14 lg:col-span-3 lg:mt-8">
                  <p class="font-sans text-sm font-semibold text-slate-600 dark:text-slate-400">
                    In discussion{sessionFormat && ` · ${sessionFormat.discussion} min`}
                  </p>
                  <div class:list={["mt-6 grid grid-cols-2 gap-x-6 gap-y-12 sm:grid-cols-3", members.length >= 6 ? "lg:grid-cols-6" : "lg:grid-cols-5"]}>
                    {members.map((person) => (
                      <PersonCard
                        name={person.name}
                        institution={person.institution}
                        role={person.role}
                        image={person.photo}
                        photoCredit={person.photoCredit}
                        photoCreditUrl={person.photoCreditUrl}
                        website={person.website}
                        links={person.links}
                        bio={person.bio}
                      />
                    ))}
                  </div>
                </div>
              )}
            </article>
          );
        })}

        {groupedPanels && unassigned.length > 0 && (
          <div>
            <header class="border-b border-slate-900/15 pb-3 dark:border-slate-100/15">
              <span class="font-sans text-sm font-semibold text-slate-600 dark:text-slate-400">
                Panel to be assigned
              </span>
            </header>
            <div class:list={["mt-6 grid grid-cols-2 gap-x-6 gap-y-12 sm:grid-cols-3", unassigned.length >= 6 ? "lg:grid-cols-6" : "lg:grid-cols-5"]}>
              {unassigned.map((person) => (
                <PersonCard
                  name={person.name}
                  institution={person.institution}
                  role={person.role}
                  image={person.photo}
                  photoCredit={person.photoCredit}
                  photoCreditUrl={person.photoCreditUrl}
                  website={person.website}
                  links={person.links}
                  bio={person.bio}
                />
              ))}
            </div>
          </div>
        )}
      </div>

      {moderators.length > 0 && (
        <div class="mt-20 max-w-4xl border-t border-slate-200 pt-7 dark:border-slate-700 md:mt-28">
          <p class="font-sans text-sm font-semibold text-slate-600 dark:text-slate-400">
            Moderators
          </p>
          <ul class="mt-5 flex flex-col gap-y-4 sm:flex-row sm:flex-wrap sm:gap-x-12">
            {moderators.map((m) => (
              <li class="flex items-center gap-x-3.5">
                {m.photo && (
                  <img
                    src={smallPhoto(m.photo)}
                    alt=""
                    width="56"
                    height="56"
                    loading="lazy"
                    decoding="async"
                    class="h-14 w-14 shrink-0 rounded-[3px] object-cover"
                  />
                )}
                <span class="flex flex-col leading-tight">
                  <a
                    href={`/people/#${slugOf(m.name)}`}
                    class="font-serif text-base text-slate-900 decoration-1 underline-offset-4 hover:underline dark:text-slate-100"
                  >{m.name}</a>
                  <span class="font-sans text-sm text-slate-600 dark:text-slate-400">{m.institution}</span>
                </span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </Section>
  )}

  {talks.length === 0 && speakers.length > 0 && (
    <Section background="white" title="Speakers">
      <div class="grid grid-cols-1 gap-12 sm:grid-cols-2 lg:grid-cols-4">
        {[...speakers].sort(byLastName).map((person) => (
          <PersonCard
            name={person.name}
            institution={person.institution}
            role={person.role}
            image={person.photo}
            photoCredit={person.photoCredit}
            photoCreditUrl={person.photoCreditUrl}
            website={person.website}
            links={person.links}
            bio={person.bio}
          />
        ))}
      </div>
    </Section>
  )}

  {panelists.length > 0 && !groupedPanels && (
    <Section background="gray" title="Discussion panel">
      <div class="grid grid-cols-1 gap-12 sm:grid-cols-2 lg:grid-cols-4">
        {[...panelists].sort(byLastName).map((person) => (
          <PersonCard
            name={person.name}
            institution={person.institution}
            role={person.role}
            image={person.photo}
            photoCredit={person.photoCredit}
            photoCreditUrl={person.photoCreditUrl}
            website={person.website}
            links={person.links}
            bio={person.bio}
          />
        ))}
      </div>
    </Section>
  )}

  {attendance.length > 0 && (
    <Section background="gray" title="Attending">
      <div class="grid gap-x-10 gap-y-12 md:grid-cols-3">
        {attendance.map((a) => (
          <div class="border-t border-slate-900/15 pt-4 dark:border-slate-100/15">
            <h3 class="font-serif text-xl text-slate-900 dark:text-slate-100">{a.group}</h3>
            <p
              class="mt-3 text-base leading-relaxed text-slate-700 dark:text-slate-300 [&_a]:font-medium [&_a]:text-accent-800 [&_a]:underline [&_a]:decoration-accent-200 [&_a]:underline-offset-2 hover:[&_a]:text-accent-800 dark:[&_a]:text-accent-300 dark:[&_a]:decoration-accent-800"
              set:html={a.note}
            />
          </div>
        ))}

        {event.data.recordingNote && (
          <div class="border-t border-slate-900/15 pt-4 dark:border-slate-100/15">
            <h3 class="font-serif text-xl text-slate-900 dark:text-slate-100">
              Recording
            </h3>
            <p class="mt-3 text-base leading-relaxed text-slate-700 dark:text-slate-300">
              {event.data.recordingNote}
            </p>
          </div>
        )}
      </div>
    </Section>
  )}

  {hasBody && (
    <Section background="white">
      <div class="max-w-3xl">
        <div class="prose-tmm">
          <Content />
        </div>
      </div>
    </Section>
  )}

  <Section background="white">
    <div>
      <Button href="/events" variant="secondary">
        &larr; Back to All Events
      </Button>
    </div>
  </Section>
</PageLayout>
