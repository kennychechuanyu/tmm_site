---
import PageLayout from "../../layouts/PageLayout.astro";
import Section from "../../components/Section.astro";
import Button from "../../components/Button.astro";
import PersonCard from "../../components/PersonCard.astro";
import RetimeLocal from "../../components/RetimeLocal.astro";
import { toInstants } from "../../utils/eventTime";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const events = await getCollection("events");
  return events.map((event) => ({
    params: { slug: event.slug },
    props: { event },
  }));
}

const { event } = Astro.props;
const { Content } = await render(event);
const hasBody = (event.body ?? "").trim().length > 0;

const eventTypeLabel =
  event.data.type.charAt(0).toUpperCase() + event.data.type.slice(1);
const eyebrow = event.data.eyebrow ?? eventTypeLabel;

// ── Date, split into typographic parts for the cover strip ───────────
const d = event.data.date;
const datePart = (opts: Intl.DateTimeFormatOptions) =>
  d ? d.toLocaleDateString("en-US", { ...opts, timeZone: "UTC" }) : "";
const dateParts = d
  ? {
      day: datePart({ day: "numeric" }),
      month: datePart({ month: "long" }),
      year: datePart({ year: "numeric" }),
      weekday: datePart({ weekday: "long" }),
    }
  : null;

// ── People and sessions ──────────────────────────────────────────────
const talks = event.data.talks ?? [];
const speakers = event.data.speakers ?? [];
const panelists = event.data.panelists ?? [];
const moderators = event.data.moderators ?? [];
/** Same slug rule as PersonCard, so a name can deep-link to its card on /people. */
const slugOf = (name: string) =>
  name.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");

const speakerByName = (name: string) => speakers.find((s) => s.name === name);
const panelistByName = (name: string) => panelists.find((p) => p.name === name);
const talkBySpeaker = (name: string) => talks.find((t) => t.speaker === name);

// Running order; falls back to the talks themselves when no programme is given
const rows =
  (event.data.programme?.length ?? 0) > 0
    ? event.data.programme!
    : talks.map((t) => ({ time: undefined, label: undefined, talk: t.speaker }));

const byLastName = (a: { name: string }, b: { name: string }) =>
  a.name.split(" ").pop()!.localeCompare(b.name.split(" ").pop()!);

/** Cards still awaiting a portrait go last, so a row never opens on a blank frame. */
const portraitsFirst = <T extends { photo?: string }>(people: T[]) => [
  ...people.filter((p) => p.photo),
  ...people.filter((p) => !p.photo),
];

// ── Absolute instants, so the browser can retime everything locally ──
const tz = event.data.timezone;
const instantsOf = (raw?: string) => toInstants(raw, d, tz);
/** Just the opening time of a range, for the compact running order. */
const startLabel = (raw?: string) => raw?.match(/\d{1,2}:\d{2}/)?.[0] ?? raw;
const eventSpan = instantsOf(event.data.time);
const aboutParas = (event.data.about ?? "").split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);

// ── Running order: every row gets a start, an end and a length ───────
const wallClock = (iso?: string) =>
  iso
    ? new Intl.DateTimeFormat("en-GB", { timeZone: tz, hour: "2-digit", minute: "2-digit", hourCycle: "h23" }).format(new Date(iso))
    : undefined;
const zoneAbbr = eventSpan
  ? new Intl.DateTimeFormat("en-GB", { timeZone: tz, hour: "numeric", timeZoneName: "short" })
      .formatToParts(new Date(eventSpan.start))
      .find((p) => p.type === "timeZoneName")?.value
  : undefined;
const sessionFormat = event.data.sessionFormat;
const timeline = rows
  .map((row) => {
    const talk = row.talk ? talkBySpeaker(row.talk) : undefined;
    const raw = talk?.time ?? row.time;
    return { row, talk, raw, at: instantsOf(raw) };
  })
  .map((r, i, all) => {
    // A row without its own end runs until the next row starts, or the event ends.
    const nextStart = all.slice(i + 1).find((x) => x.at?.start)?.at?.start;
    const end = r.at?.end ?? nextStart ?? eventSpan?.end;
    const minutes =
      r.at?.start && end ? Math.round((new Date(end).getTime() - new Date(r.at.start).getTime()) / 60000) : undefined;
    const label = r.at?.start ? `${wallClock(r.at.start)} – ${wallClock(end)}` : r.raw;
    return { ...r, end, minutes, label };
  });
/** Static .ics built by src/pages/events/[slug].ics.ts for dated, timed events. */
const icsHref = eventSpan ? `/events/${event.slug}.ics` : undefined;

// Panel membership; anyone not yet assigned to a session is shown separately
const assigned = new Set(talks.flatMap((t) => t.panel ?? []));
const unassigned = portraitsFirst(
  panelists.filter((p) => !assigned.has(p.name)).sort(byLastName)
);
const groupedPanels = talks.some((t) => (t.panel?.length ?? 0) > 0);

// ── Chapter numerals adapt to which chapters this event has ──────────
const roman = ["I", "II", "III", "IV", "V", "VI"];
const chapterIds = [
  event.data.about && "about",
  talks.length > 0 && "programme",
  talks.length === 0 && speakers.length > 0 && "speakers",
  panelists.length > 0 && !groupedPanels && "panel",
  (event.data.attendance?.length ?? 0) > 0 && "attending",
].filter(Boolean) as string[];
const numeralOf = (id: string) => roman[chapterIds.indexOf(id)];
---

<PageLayout
  title={event.data.title}
  description={event.data.description}
  subtitle={event.data.deck}
  eyebrow={eyebrow}
  image={event.data.ogImage}
  titleClearance={0.76}
  compact
>
  <!-- ─── Cover strip: when · time · where · register ──────────────── -->
  <section class="border-b border-slate-900/10 bg-white dark:border-slate-100/10 dark:bg-slate-950">
    <div class="container-wide py-10 md:py-12">
      <dl class="grid gap-x-10 gap-y-8 sm:grid-cols-2 md:flex md:items-stretch md:gap-0 md:divide-x md:divide-slate-200 dark:md:divide-slate-800">
        <div class="flex flex-col gap-2.5 md:pr-12">
          <dt class="font-sans text-[10px] font-medium uppercase text-slate-400 dark:text-slate-500" style="letter-spacing: 0.22em;">
            When
          </dt>
          <dd>
            {dateParts ? (
              <span class="flex items-baseline gap-3.5" data-local-date={eventSpan?.start} data-tz={tz}>
                <span data-part="day" class="font-serif text-5xl leading-[0.85] tabular-nums text-slate-900 dark:text-slate-100 md:text-6xl">
                  {dateParts.day}
                </span>
                <span class="flex flex-col gap-1 font-sans text-[10px] uppercase" style="letter-spacing: 0.22em;">
                  <span data-part="month-year" class="text-slate-900 dark:text-slate-100">{dateParts.month} {dateParts.year}</span>
                  <span data-part="weekday" class="text-slate-400 dark:text-slate-500">{dateParts.weekday}</span>
                </span>
              </span>
            ) : (
              <span class="font-serif text-lg text-slate-900 dark:text-slate-100">Date to be announced</span>
            )}
          </dd>
        </div>

        {event.data.time && (
          <div class="flex flex-col gap-2.5 md:px-12">
            <dt class="font-sans text-[10px] font-medium uppercase text-slate-400 dark:text-slate-500" style="letter-spacing: 0.22em;">
              Time
            </dt>
            <dd>
              <p class="font-serif text-lg leading-snug text-slate-900 dark:text-slate-100">
                <time
                  datetime={eventSpan?.start}
                  data-local-time
                  data-end={eventSpan?.end}
                  data-tz={tz}
                >{event.data.time}</time>
              </p>
              {event.data.timeNote && (
                <p
                  class="mt-2 max-w-[15rem] font-mono text-[11px] leading-relaxed text-slate-500 dark:text-slate-400"
                  data-local-note
                  data-source={event.data.time}
                  data-at={eventSpan?.start}
                  data-tz={tz}
                >{event.data.timeNote}</p>
              )}
            </dd>
          </div>
        )}

        <div class="flex flex-col gap-2.5 md:px-12">
          <dt class="font-sans text-[10px] font-medium uppercase text-slate-400 dark:text-slate-500" style="letter-spacing: 0.22em;">
            Where
          </dt>
          <dd class="font-serif text-lg leading-snug text-slate-900 dark:text-slate-100">
            {event.data.location}
          </dd>
        </div>

        <div class="flex flex-col items-start justify-center gap-2.5 sm:col-span-2 md:col-span-1 md:ml-auto md:pl-12">
          {event.data.registrationUrl ? (
            <Button href={event.data.registrationUrl} external>
              Register Now
            </Button>
          ) : (
            <p class="font-serif text-sm italic text-slate-400 dark:text-slate-500">
              Registration opens soon.
            </p>
          )}
          {(event.data.admission || icsHref) && (
            <p class="font-sans text-xs text-slate-500 dark:text-slate-400">
              {event.data.admission && <span>{event.data.admission}</span>}
              {event.data.admission && icsHref && (
                <span aria-hidden="true" class="mx-1.5 text-slate-300 dark:text-slate-600">·</span>
              )}
              {icsHref && (
                <a
                  href={icsHref}
                  class="underline decoration-slate-300 underline-offset-2 transition-colors hover:text-salmon-600 dark:decoration-slate-600 dark:hover:text-salmon-400"
                >Add to calendar</a>
              )}
            </p>
          )}
        </div>
      </dl>
    </div>
  </section>

  <!-- ─── About ───────────────────────────────────────────────────── -->
  {event.data.about && (
    <Section background="gray" numeral={numeralOf("about")} title="About">
      {/* Beat one — the setting, and the tension in it. Two paragraphs sit side by side
          so the prose uses the whole column at a readable measure. */}
      <div class:list={[aboutParas.length === 2 ? "grid gap-y-6 lg:grid-cols-2 lg:gap-x-14" : "lg:columns-2 lg:gap-x-14"]}>
        {aboutParas.map((para, i) => (
          <p
            class:list={[
              aboutParas.length !== 2 && i > 0 && "mt-5",
              "text-pretty font-serif text-lg leading-[1.7] text-slate-700 dark:text-slate-300 md:text-[1.375rem] md:leading-[1.65]",
            ]}
            set:html={para}
          />
        ))}
      </div>

      {/* Beat two — the questions the event turns on */}
      {event.data.questions && event.data.questions.length > 0 && (
        <div class="mt-16 border-t border-slate-900/15 pt-10 dark:border-slate-100/15 md:mt-20 md:pt-14">
          <p class="font-sans text-[10px] font-medium uppercase text-salmon-600 dark:text-salmon-400" style="letter-spacing: 0.24em;">
            Questions in play
          </p>

          <div class="mt-10 grid gap-x-12 gap-y-12 md:mt-12 md:grid-cols-2">
            {event.data.questions.map((q, i) => (
              <div class="relative pt-6">
                <span aria-hidden="true" class="absolute inset-x-0 top-0 h-px bg-slate-200 dark:bg-slate-700"></span>
                <span aria-hidden="true" class="absolute left-0 top-0 h-[2px] w-8 bg-salmon-500 dark:bg-salmon-400"></span>
                <p class="font-mono text-xs text-salmon-600 dark:text-salmon-400">0{i + 1}</p>
                <p class="mt-2.5 font-sans text-[11px] font-semibold uppercase text-navy-600 dark:text-navy-400" style="letter-spacing: 0.18em;">
                  {q.label}
                </p>
                <p class="mt-4 font-serif text-lg leading-normal text-slate-800 dark:text-slate-200">
                  {q.text}
                </p>
              </div>
            ))}
          </div>
        </div>
      )}

      {/* Beat three — how it will be done. Quiet by design. */}
      {event.data.aboutCoda && event.data.aboutCoda.length > 0 && (
        <div class="mt-16 grid gap-x-12 gap-y-10 border-t border-slate-200 pt-10 dark:border-slate-700 md:mt-20 md:grid-cols-2">
          {event.data.aboutCoda.map((block) => (
            <div>
              <p class="font-sans text-[10px] font-medium uppercase text-slate-400 dark:text-slate-500" style="letter-spacing: 0.22em;">
                {block.label}
              </p>
              <p class="mt-3.5 max-w-[56ch] text-pretty text-[15px] leading-[1.8] text-slate-600 dark:text-slate-400">
                {block.text}
              </p>
            </div>
          ))}
        </div>
      )}
    </Section>
  )}

  <!-- ─── Programme: each session with its speaker and panel ──────── -->
  {talks.length > 0 && (
    <Section
      background="white"
      numeral={numeralOf("programme")}
      title="Programme"
    >
      {/* At a glance: every row with its start, end and length; sessions numbered to match the detail below */}
      <table class="mb-20 w-full border-collapse md:mb-24">
        <thead>
          <tr class="border-b border-slate-900/15 dark:border-slate-100/15">
            <th scope="col" class="pb-3 pr-4 text-left font-sans text-[10px] font-medium uppercase text-slate-400 dark:text-slate-500 md:pr-6" style="letter-spacing: 0.22em;">
              Time{zoneAbbr && (
                <span> · <span data-local-zone data-at={eventSpan?.start} data-tz={tz}>{zoneAbbr}</span></span>
              )}
            </th>
            <th scope="col" class="pb-3 text-left font-sans text-[10px] font-medium uppercase text-slate-400 dark:text-slate-500" style="letter-spacing: 0.22em;">
              Programme
            </th>
            <th scope="col" class="hidden pb-3 pl-4 text-right font-sans text-[10px] font-medium uppercase text-slate-400 dark:text-slate-500 sm:table-cell" style="letter-spacing: 0.22em;">
              Length
            </th>
          </tr>
        </thead>
        <tbody>
          {timeline.map(({ row, talk, at, end, minutes, label }) => {
            const idx = talk ? talks.indexOf(talk) : -1;
            const isBreak = !talk && /break/i.test(row.label ?? "");
            return (
              <tr class:list={[
                "border-b border-slate-200 dark:border-slate-700",
                isBreak && "bg-slate-50/80 dark:bg-slate-900/40",
              ]}>
                <td class="whitespace-nowrap py-4 pr-4 align-top font-mono text-xs tabular-nums leading-6 text-slate-500 dark:text-slate-400 md:pr-6">
                  <time
                    datetime={at?.start}
                    data-local-time
                    data-compact
                    data-end={end}
                    data-tz={tz}
                    data-ref={eventSpan?.start}
                  >{label}</time>
                </td>
                <td class="py-4 align-top">
                  <div class="flex items-start gap-3 md:gap-4">
                    <span aria-hidden="true" class="w-4 shrink-0 font-serif text-lg leading-6 text-salmon-500 dark:text-salmon-400 md:text-xl">
                      {talk ? idx + 1 : ""}
                    </span>
                    {talk ? (
                      <div class="min-w-0">
                        <a href={`#session-${idx + 1}`} class="group inline-flex items-baseline gap-2">
                          <span class="font-serif text-base leading-6 text-slate-900 decoration-salmon-400/60 underline-offset-4 group-hover:underline dark:text-slate-100 md:text-lg">
                            {talk.title}
                          </span>
                          <svg aria-hidden="true" class="h-3 w-3 shrink-0 translate-y-px text-slate-300 transition-transform duration-300 group-hover:translate-y-1 group-hover:text-salmon-500 dark:text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v13m0 0 5.5-5.5M12 18l-5.5-5.5" />
                          </svg>
                        </a>
                        <p class="mt-1 font-sans text-[13px] text-slate-500 dark:text-slate-400">
                          <span class="text-slate-700 dark:text-slate-300">{talk.speaker}</span>
                          {sessionFormat && (
                            <span> · Talk {sessionFormat.talk} min · Discussion {sessionFormat.discussion} min</span>
                          )}
                        </p>
                      </div>
                    ) : (
                      <span class="font-sans text-sm leading-6 text-slate-500 dark:text-slate-400">{row.label}</span>
                    )}
                  </div>
                </td>
                <td class="hidden whitespace-nowrap py-4 pl-4 text-right align-top font-mono text-xs tabular-nums leading-6 text-slate-400 dark:text-slate-500 sm:table-cell">
                  {minutes !== undefined && `${minutes} min`}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>

      {/* Each session in full: the talk, its speaker, and the panel that responds */}
      <div class="space-y-20 md:space-y-28">
        {talks.map((talk, idx) => {
          const sp = speakerByName(talk.speaker);
          const span = instantsOf(talk.time);
          const sessionLabel = span ? `${wallClock(span.start)} – ${wallClock(span.end)}` : talk.time;
          const members = portraitsFirst(
            (talk.panel ?? []).flatMap((n) => {
              const p = panelistByName(n);
              return p ? [p] : [];
            })
          );
          return (
            <article
              id={`session-${idx + 1}`}
              class="scroll-fade-in scroll-mt-24 border-t border-slate-900/15 pt-8 dark:border-slate-100/15 lg:grid lg:grid-cols-[11rem_minmax(0,1fr)_11rem] lg:gap-x-14 lg:gap-y-7"
            >
              {/* Meta column: numeral, session, time, format. A row on small screens, a column beside the talk on large ones. */}
              <div class="flex flex-wrap items-baseline gap-x-5 gap-y-2 lg:row-span-2 lg:flex-col lg:items-start lg:gap-y-3">
                <span class="font-serif text-4xl italic leading-none text-salmon-500 dark:text-salmon-400 md:text-5xl">
                  {idx + 1}
                </span>
                <span class="font-sans text-[11px] font-semibold uppercase text-navy-600 dark:text-navy-400 lg:mt-1" style="letter-spacing: 0.18em;">
                  Session
                </span>
                {span && (
                  <time
                    datetime={span.start}
                    data-local-time
                    data-end={span.end}
                    data-compact
                    data-tz={tz}
                    data-ref={eventSpan?.start}
                    class="font-mono text-xs tabular-nums text-slate-500 dark:text-slate-400"
                  >{sessionLabel}</time>
                )}
                {sessionFormat && (
                  <span class="font-mono text-xs text-slate-400 dark:text-slate-500">
                    Talk {sessionFormat.talk} min<span class="lg:hidden"> · </span><br class="hidden lg:block" />Discussion {sessionFormat.discussion} min
                  </span>
                )}
              </div>

              {/* The title spans the talk and the speaker; the abstract and the portrait share the row beneath */}
              <h3 class="mt-6 text-pretty font-serif text-2xl leading-[1.25] text-slate-900 dark:text-white md:text-3xl lg:col-span-2 lg:mt-0" style="letter-spacing: -0.01em;">
                {talk.title}
              </h3>
              <p class="mt-5 text-pretty font-serif text-[17px] leading-[1.7] text-slate-700 dark:text-slate-300 md:text-xl md:leading-[1.7] lg:mt-0">
                {talk.abstract}
              </p>
              {sp && (
                <div class="mt-10 w-full lg:mt-0 lg:w-44">
                  <PersonCard
                    name={sp.name}
                    institution={sp.institution}
                    role={sp.role}
                    image={sp.photo}
                    photoCredit={sp.photoCredit}
                    photoCreditUrl={sp.photoCreditUrl}
                    website={sp.website}
                    links={sp.links}
                    bio={sp.bio}
                    tag="Speaker"
                  />
                </div>
              )}

              {members.length > 0 && (
                <div class="mt-14 lg:col-span-3 lg:mt-8">
                  <p class="font-sans text-[10px] font-medium uppercase text-slate-400 dark:text-slate-500" style="letter-spacing: 0.22em;">
                    In discussion{sessionFormat && ` · ${sessionFormat.discussion} min`}
                  </p>
                  <div class:list={["stagger-grid mt-8 grid grid-cols-2 gap-x-6 gap-y-12 sm:grid-cols-3", members.length >= 6 ? "lg:grid-cols-6" : "lg:grid-cols-5"]}>
                    {members.map((person, i) => (
                      <PersonCard
                        name={person.name}
                        institution={person.institution}
                        role={person.role}
                        image={person.photo}
                        photoCredit={person.photoCredit}
                        photoCreditUrl={person.photoCreditUrl}
                        website={person.website}
                        links={person.links}
                        bio={person.bio}
                        stagger={Math.min(i * 60, 480)}
                      />
                    ))}
                  </div>
                </div>
              )}
            </article>
          );
        })}

        {groupedPanels && unassigned.length > 0 && (
          <div>
            <header class="border-b border-slate-900/15 pb-3 dark:border-slate-100/15">
              <span class="font-sans text-[11px] font-semibold uppercase text-slate-400 dark:text-slate-500" style="letter-spacing: 0.18em;">
                Panel to be assigned
              </span>
            </header>
            <div class:list={["stagger-grid mt-8 grid grid-cols-2 gap-x-6 gap-y-12 sm:grid-cols-3", unassigned.length >= 6 ? "lg:grid-cols-6" : "lg:grid-cols-5"]}>
              {unassigned.map((person, i) => (
                <PersonCard
                  name={person.name}
                  institution={person.institution}
                  role={person.role}
                  image={person.photo}
                  photoCredit={person.photoCredit}
                  photoCreditUrl={person.photoCreditUrl}
                  website={person.website}
                  links={person.links}
                  bio={person.bio}
                  stagger={Math.min(i * 60, 480)}
                />
              ))}
            </div>
          </div>
        )}
      </div>

      {/* Who chairs it — a footnote to the programme, not a third tier of people */}
      {moderators.length > 0 && (
        <aside class="mt-20 max-w-4xl border-t border-slate-200 pt-7 dark:border-slate-700 md:mt-28">
          <p class="font-sans text-[10px] font-medium uppercase text-slate-400 dark:text-slate-500" style="letter-spacing: 0.22em;">
            Moderators
          </p>
          <ul class="mt-5 flex flex-col gap-y-4 sm:flex-row sm:flex-wrap sm:gap-x-12">
            {moderators.map((m) => (
              <li class="flex items-center gap-x-3.5">
                {m.photo && (
                  <img
                    src={m.photo}
                    alt=""
                    width="56"
                    height="56"
                    loading="lazy"
                    decoding="async"
                    class="h-14 w-14 shrink-0 rounded-full object-cover ring-1 ring-slate-900/10 dark:ring-slate-100/10"
                  />
                )}
                <span class="flex flex-col leading-tight">
                  <a
                    href={`/people/#${slugOf(m.name)}`}
                    class="font-serif text-base text-slate-900 decoration-salmon-400/60 underline-offset-4 hover:underline dark:text-slate-100"
                  >{m.name}</a>
                  <span class="font-sans text-[13px] text-slate-500 dark:text-slate-400">{m.institution}</span>
                </span>
              </li>
            ))}
          </ul>
        </aside>
      )}
    </Section>
  )}

  <!-- ─── Speakers (only for events without a session programme) ──── -->
  {talks.length === 0 && speakers.length > 0 && (
    <Section background="white" numeral={numeralOf("speakers")} title="Speakers">
      <div class="stagger-grid grid grid-cols-1 gap-12 sm:grid-cols-2 lg:grid-cols-4">
        {[...speakers].sort(byLastName).map((person, i) => (
          <PersonCard
            name={person.name}
            institution={person.institution}
            role={person.role}
            image={person.photo}
            photoCredit={person.photoCredit}
            photoCreditUrl={person.photoCreditUrl}
            website={person.website}
            links={person.links}
            bio={person.bio}
            stagger={Math.min(i * 70, 560)}
          />
        ))}
      </div>
    </Section>
  )}

  <!-- ─── Discussion panel (only when not grouped into sessions) ──── -->
  {panelists.length > 0 && !groupedPanels && (
    <Section background="gray" numeral={numeralOf("panel")} title="Discussion panel" metaLabel={`${panelists.length} discussants`}>
      <div class="stagger-grid grid grid-cols-1 gap-12 sm:grid-cols-2 lg:grid-cols-4">
        {[...panelists].sort(byLastName).map((person, i) => (
          <PersonCard
            name={person.name}
            institution={person.institution}
            role={person.role}
            image={person.photo}
            photoCredit={person.photoCredit}
            photoCreditUrl={person.photoCreditUrl}
            website={person.website}
            links={person.links}
            bio={person.bio}
            stagger={Math.min(i * 70, 560)}
          />
        ))}
      </div>
    </Section>
  )}

  <!-- ─── Attending ───────────────────────────────────────────────── -->
  {event.data.attendance && event.data.attendance.length > 0 && (
    <Section background="gray" numeral={numeralOf("attending")} title="Attending" metaLabel="Practical details">
      <div class="grid gap-x-10 gap-y-12 md:grid-cols-3">
        {event.data.attendance.map((a) => (
          <div class="relative pt-6">
            <span aria-hidden="true" class="absolute inset-x-0 top-0 h-px bg-slate-200 dark:bg-slate-700"></span>
            <span aria-hidden="true" class="absolute left-0 top-0 h-[2px] w-8 bg-salmon-500 dark:bg-salmon-400"></span>
            <h3 class="font-serif text-xl text-slate-900 dark:text-slate-100">{a.group}</h3>
            <p
              class="mt-3.5 text-[15px] leading-relaxed text-slate-600 dark:text-slate-400 [&_a]:font-medium [&_a]:text-navy-600 [&_a]:underline [&_a]:decoration-navy-300 [&_a]:underline-offset-2 hover:[&_a]:text-salmon-600 dark:[&_a]:text-navy-400 dark:[&_a]:decoration-navy-700"
              set:html={a.note}
            />
          </div>
        ))}

        {event.data.recordingNote && (
          <div class="relative pt-6">
            <span aria-hidden="true" class="absolute inset-x-0 top-0 h-px bg-slate-200 dark:bg-slate-700"></span>
            <span aria-hidden="true" class="absolute left-0 top-0 h-[2px] w-8 bg-salmon-500 dark:bg-salmon-400"></span>
            <h3 class="flex items-center gap-2.5 font-serif text-xl text-slate-900 dark:text-slate-100">
              <span aria-hidden="true" class="relative flex h-2 w-2">
                <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-salmon-400 opacity-60"></span>
                <span class="relative inline-flex h-2 w-2 rounded-full bg-salmon-500"></span>
              </span>
              Recording
            </h3>
            <p class="mt-3.5 text-[15px] leading-relaxed text-slate-600 dark:text-slate-400">
              {event.data.recordingNote}
            </p>
          </div>
        )}
      </div>
    </Section>
  )}

  <!-- ─── Further details from the markdown body, if any ──────────── -->
  {hasBody && (
    <Section background="white">
      <div class="mx-auto max-w-3xl">
        <div class="prose-tmm">
          <Content />
        </div>
      </div>
    </Section>
  )}

  <!-- ─── Back ────────────────────────────────────────────────────── -->
  <Section background="white">
    <div class="text-center">
      <Button href="/events" variant="secondary">
        &larr; Back to All Events
      </Button>
    </div>
  </Section>
  {eventSpan && <RetimeLocal />}
</PageLayout>
