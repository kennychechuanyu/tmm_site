---
import PageLayout from "../../layouts/PageLayout.astro";
import Section from "../../components/Section.astro";
import Button from "../../components/Button.astro";
import PersonCard from "../../components/PersonCard.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const events = await getCollection("events");
  return events.map((event) => ({
    params: { slug: event.slug },
    props: { event },
  }));
}

const { event } = Astro.props;
const { Content } = await render(event);
const hasBody = (event.body ?? "").trim().length > 0;

const eventTypeLabel =
  event.data.type.charAt(0).toUpperCase() + event.data.type.slice(1);
const eyebrow = event.data.featured
  ? `${eventTypeLabel} · Featured`
  : eventTypeLabel;

// ── Date, split into typographic parts for the cover strip ───────────
const d = event.data.date;
const datePart = (opts: Intl.DateTimeFormatOptions) =>
  d ? d.toLocaleDateString("en-US", { ...opts, timeZone: "UTC" }) : "";
const dateParts = d
  ? {
      day: datePart({ day: "numeric" }),
      month: datePart({ month: "long" }),
      year: datePart({ year: "numeric" }),
      weekday: datePart({ weekday: "long" }),
    }
  : null;
const longDate = d
  ? `${datePart({ weekday: "long" })}, ${datePart({ month: "long", day: "numeric", year: "numeric" })}`
  : "Date to be announced";

// ── People lookups ───────────────────────────────────────────────────
const talks = event.data.talks ?? [];
const programme = event.data.programme ?? [];
const speakers = event.data.speakers ?? [];
const panelists = event.data.panelists ?? [];

const speakerByName = (name: string) => speakers.find((s) => s.name === name);
const panelistByName = (name: string) => panelists.find((p) => p.name === name);
const talkBySpeaker = (name: string) => talks.find((t) => t.speaker === name);

// Same slug rule as PersonCard, so #links open the matching profile card
const slugFor = (name: string) =>
  name.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
const initialsFor = (name: string) =>
  name.replace(/\s*\(.*?\)\s*/g, " ").trim().split(" ").map((n) => n[0]).join("").slice(0, 2).toUpperCase();

// Speakers follow the running order when talks are declared
const talkOrder = (name: string) => {
  const i = talks.findIndex((t) => t.speaker === name);
  return i === -1 ? talks.length : i;
};
const byLastName = (a: { name: string }, b: { name: string }) =>
  a.name.split(" ").pop()!.localeCompare(b.name.split(" ").pop()!);
const sortedSpeakers = [...speakers].sort(
  talks.length > 0 ? (a, b) => talkOrder(a.name) - talkOrder(b.name) : byLastName
);

// Panel groups per talk, plus anyone not yet assigned to a session
const assigned = new Set(talks.flatMap((t) => t.panel ?? []));
const unassigned = panelists.filter((p) => !assigned.has(p.name)).sort(byLastName);
const groupedPanels = talks.some((t) => (t.panel?.length ?? 0) > 0);
---

<PageLayout
  title={event.data.title}
  description={event.data.description}
  eyebrow={eyebrow}
  compact
>
  <!-- ─── Cover strip: when · time · where · register ──────────────── -->
  <section class="border-b border-slate-900/10 bg-white dark:border-slate-100/10 dark:bg-slate-950">
    <div class="container-wide py-10 md:py-12">
      <dl class="grid gap-x-10 gap-y-8 sm:grid-cols-2 md:flex md:items-stretch md:gap-0 md:divide-x md:divide-slate-200 dark:md:divide-slate-800">
        <div class="flex flex-col gap-2.5 md:pr-12">
          <dt class="font-sans text-[10px] font-medium uppercase text-slate-400 dark:text-slate-500" style="letter-spacing: 0.22em;">
            When
          </dt>
          <dd>
            {dateParts ? (
              <span class="flex items-baseline gap-3.5">
                <span class="font-serif text-5xl leading-[0.85] tabular-nums text-slate-900 dark:text-slate-100 md:text-6xl">
                  {dateParts.day}
                </span>
                <span class="flex flex-col gap-1 font-sans text-[10px] uppercase" style="letter-spacing: 0.22em;">
                  <span class="text-slate-900 dark:text-slate-100">{dateParts.month} {dateParts.year}</span>
                  <span class="text-slate-400 dark:text-slate-500">{dateParts.weekday}</span>
                </span>
              </span>
            ) : (
              <span class="font-serif text-lg text-slate-900 dark:text-slate-100">{longDate}</span>
            )}
          </dd>
        </div>

        {event.data.time && (
          <div class="flex flex-col gap-2.5 md:px-12">
            <dt class="font-sans text-[10px] font-medium uppercase text-slate-400 dark:text-slate-500" style="letter-spacing: 0.22em;">
              Time
            </dt>
            <dd>
              <p class="font-serif text-lg leading-snug text-slate-900 dark:text-slate-100">
                {event.data.time}
              </p>
              {event.data.timeNote && (
                <p class="mt-1.5 font-mono text-[11px] text-slate-500 dark:text-slate-400">
                  {event.data.timeNote}
                </p>
              )}
            </dd>
          </div>
        )}

        <div class="flex flex-col gap-2.5 md:px-12">
          <dt class="font-sans text-[10px] font-medium uppercase text-slate-400 dark:text-slate-500" style="letter-spacing: 0.22em;">
            Where
          </dt>
          <dd class="font-serif text-lg leading-snug text-slate-900 dark:text-slate-100">
            {event.data.location}
          </dd>
        </div>

        <div class="flex items-center sm:col-span-2 md:col-span-1 md:ml-auto md:pl-12">
          {event.data.registrationUrl ? (
            <Button href={event.data.registrationUrl} external>
              Register Now
            </Button>
          ) : (
            <p class="font-serif text-sm italic text-slate-400 dark:text-slate-500">
              Registration opens soon.
            </p>
          )}
        </div>
      </dl>
    </div>
  </section>

  <!-- ─── I. About ────────────────────────────────────────────────── -->
  {event.data.about && (
    <Section background="gray" numeral="I" title="About" metaLabel="A TMM event">
      <div class="max-w-3xl">
        <p class="font-serif text-xl italic leading-relaxed text-slate-700 dark:text-slate-300" style="text-indent: 1.5em;">
          {event.data.about}
        </p>

        {event.data.questions && event.data.questions.length > 0 && (
          <div class="mt-12">
            <p class="mb-2 font-sans text-[10px] font-medium uppercase text-slate-400 dark:text-slate-500" style="letter-spacing: 0.22em;">
              Guiding questions
            </p>
            <div class="divide-y divide-slate-200 border-y border-slate-200 dark:divide-slate-700 dark:border-slate-700">
              {event.data.questions.map((q) => (
                <div class="grid gap-2 py-5 md:grid-cols-[140px_1fr] md:gap-8">
                  <p class="font-sans text-[11px] font-semibold uppercase text-navy-600 dark:text-navy-400" style="letter-spacing: 0.18em; padding-top: 2px;">
                    {q.label}
                  </p>
                  <p class="text-[15px] leading-relaxed text-slate-600 dark:text-slate-400">
                    {q.text}
                  </p>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
    </Section>
  )}

  <!-- ─── II. Programme: the running order as a timeline ──────────── -->
  {programme.length > 0 && (
    <Section background="white" numeral="II" title="Programme" metaLabel="All times CEST">
      <ol class="relative ml-1 max-w-4xl list-none border-l border-slate-200 dark:border-slate-700">
        {programme.map((row) => {
          const talk = row.talk ? talkBySpeaker(row.talk) : undefined;

          {/* Plain moment: welcome, break, Q&A, closing */}
          if (!talk) {
            return (
              <li class="scroll-fade-in relative pb-10 pl-8 last:pb-0 md:pl-12">
                <span aria-hidden="true" class="absolute -left-[4.5px] top-[5px] h-2 w-2 rounded-full bg-slate-300 ring-4 ring-white dark:bg-slate-600 dark:ring-slate-900"></span>
                <p class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
                  {row.time && (
                    <span class="font-mono text-xs tabular-nums text-slate-400 dark:text-slate-500">{row.time}</span>
                  )}
                  <span class="font-sans text-sm font-medium text-slate-600 dark:text-slate-400">{row.label}</span>
                </p>
              </li>
            );
          }

          {/* Session: talk + its discussion panel */}
          const idx = talks.indexOf(talk);
          const sp = speakerByName(talk.speaker);
          const panel = (talk.panel ?? []).map((n) => ({ name: n, person: panelistByName(n) }));
          return (
            <li class="scroll-fade-in relative pb-14 pl-8 last:pb-0 md:pl-12">
              <span aria-hidden="true" class="absolute -left-[5.5px] top-[5px] h-[10px] w-[10px] rounded-full bg-salmon-500 ring-4 ring-white dark:bg-salmon-400 dark:ring-slate-900"></span>

              <p class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
                <span class="font-sans text-[11px] font-semibold uppercase text-navy-600 dark:text-navy-400" style="letter-spacing: 0.18em;">
                  Session {idx + 1}
                </span>
                {talk.time && (
                  <span class="font-mono text-xs tabular-nums text-slate-400 dark:text-slate-500">{talk.time}</span>
                )}
              </p>

              <h3 class="mt-3 max-w-[26ch] font-serif text-2xl leading-snug text-slate-900 dark:text-white md:text-3xl" style="letter-spacing: -0.01em;">
                {talk.title}
              </h3>

              <p class="mt-3 font-sans text-sm">
                {sp?.website ? (
                  <a href={sp.website} target="_blank" rel="noopener noreferrer" class="font-medium text-navy-600 transition-colors hover:text-salmon-600 dark:text-navy-400 dark:hover:text-salmon-400">
                    {talk.speaker}
                  </a>
                ) : (
                  <span class="font-medium text-slate-800 dark:text-slate-200">{talk.speaker}</span>
                )}
                {sp?.institution && (
                  <span class="text-slate-500 dark:text-slate-400"> · {sp.institution}</span>
                )}
              </p>

              <p class="mt-4 max-w-[68ch] text-pretty text-[15px] leading-[1.8] text-slate-600 dark:text-slate-300">
                {talk.abstract}
              </p>

              {panel.length > 0 && (
                <div class="mt-6">
                  <p class="font-sans text-[10px] font-medium uppercase text-slate-400 dark:text-slate-500" style="letter-spacing: 0.22em;">
                    In discussion
                  </p>
                  <div class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-3">
                    <span class="flex -space-x-2">
                      {panel.map(({ name, person }) => (
                        <a href={`#${slugFor(name)}`} class="group relative block" title={name}>
                          {person?.photo ? (
                            <img
                              src={person.photo}
                              alt={name}
                              loading="lazy"
                              class="h-9 w-9 rounded-full object-cover object-[center_30%] ring-2 ring-white transition-transform duration-300 group-hover:-translate-y-0.5 dark:ring-slate-900"
                            />
                          ) : (
                            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-slate-100 font-serif text-[10px] text-slate-400 ring-2 ring-white transition-transform duration-300 group-hover:-translate-y-0.5 dark:bg-slate-800 dark:text-slate-500 dark:ring-slate-900">
                              {initialsFor(name)}
                            </span>
                          )}
                        </a>
                      ))}
                    </span>
                    <p class="font-sans text-sm leading-relaxed text-slate-500 dark:text-slate-400">
                      {panel.map(({ name }, i) => (
                        <Fragment>
                          <a href={`#${slugFor(name)}`} class="text-navy-600 transition-colors hover:text-salmon-600 dark:text-navy-400 dark:hover:text-salmon-400">{name}</a>{i < panel.length - 1 && <span aria-hidden="true"> · </span>}
                        </Fragment>
                      ))}
                    </p>
                  </div>
                </div>
              )}
            </li>
          );
        })}
      </ol>
    </Section>
  )}

  <!-- ─── III. Speakers ───────────────────────────────────────────── -->
  {sortedSpeakers.length > 0 && (
    <Section background="gray" numeral="III" title="Speakers" metaLabel="In order of appearance">
      <div class="stagger-grid grid grid-cols-1 gap-12 sm:grid-cols-2 lg:grid-cols-4">
        {sortedSpeakers.map((person, i) => (
          <PersonCard
            name={person.name}
            institution={person.institution}
            role={person.role}
            image={person.photo}
            photoCredit={person.photoCredit}
            photoCreditUrl={person.photoCreditUrl}
            website={person.website}
            links={person.links}
            bio={person.bio}
            stagger={Math.min(i * 70, 560)}
          />
        ))}
      </div>
    </Section>
  )}

  <!-- ─── IV. Discussion panel, grouped by session ────────────────── -->
  {panelists.length > 0 && (
    <Section background="white" numeral="IV" title="Discussion panel" metaLabel={`${panelists.length} discussants`}>
      {groupedPanels ? (
        <div class="space-y-20">
          {talks.map((talk, idx) => {
            const members = (talk.panel ?? [])
              .map((n) => panelistByName(n))
              .filter(Boolean) as typeof panelists;
            if (members.length === 0) return null;
            return (
              <div>
                <header class="flex flex-wrap items-baseline gap-x-4 gap-y-1 border-b border-slate-200 pb-3 dark:border-slate-700">
                  <span class="font-sans text-[11px] font-semibold uppercase text-navy-600 dark:text-navy-400" style="letter-spacing: 0.18em;">
                    Panel {idx + 1}
                  </span>
                  <span class="font-serif text-lg italic text-slate-600 dark:text-slate-400">
                    with {talk.speaker}
                  </span>
                  {talk.time && (
                    <span class="ml-auto font-mono text-xs tabular-nums text-slate-400 dark:text-slate-500">{talk.time}</span>
                  )}
                </header>
                <div class="stagger-grid mt-10 grid grid-cols-1 gap-12 sm:grid-cols-2 lg:grid-cols-4">
                  {members.map((person, i) => (
                    <PersonCard
                      name={person.name}
                      institution={person.institution}
                      role={person.role}
                      image={person.photo}
                      photoCredit={person.photoCredit}
                      photoCreditUrl={person.photoCreditUrl}
                      website={person.website}
                      links={person.links}
                      bio={person.bio}
                      stagger={Math.min(i * 70, 560)}
                    />
                  ))}
                </div>
              </div>
            );
          })}

          {unassigned.length > 0 && (
            <div>
              <header class="flex flex-wrap items-baseline gap-x-4 gap-y-1 border-b border-slate-200 pb-3 dark:border-slate-700">
                <span class="font-sans text-[11px] font-semibold uppercase text-slate-400 dark:text-slate-500" style="letter-spacing: 0.18em;">
                  Panel to be assigned
                </span>
              </header>
              <div class="stagger-grid mt-10 grid grid-cols-1 gap-12 sm:grid-cols-2 lg:grid-cols-4">
                {unassigned.map((person, i) => (
                  <PersonCard
                    name={person.name}
                    institution={person.institution}
                    role={person.role}
                    image={person.photo}
                    photoCredit={person.photoCredit}
                    photoCreditUrl={person.photoCreditUrl}
                    website={person.website}
                    links={person.links}
                    bio={person.bio}
                    stagger={Math.min(i * 70, 560)}
                  />
                ))}
              </div>
            </div>
          )}
        </div>
      ) : (
        <div class="stagger-grid grid grid-cols-1 gap-12 sm:grid-cols-2 lg:grid-cols-4">
          {[...panelists].sort(byLastName).map((person, i) => (
            <PersonCard
              name={person.name}
              institution={person.institution}
              role={person.role}
              image={person.photo}
              photoCredit={person.photoCredit}
              photoCreditUrl={person.photoCreditUrl}
              website={person.website}
              links={person.links}
              bio={person.bio}
              stagger={Math.min(i * 70, 560)}
            />
          ))}
        </div>
      )}
    </Section>
  )}

  <!-- ─── V. Attending ────────────────────────────────────────────── -->
  {event.data.attendance && event.data.attendance.length > 0 && (
    <Section background="gray" numeral="V" title="Attending" metaLabel="Practical details">
      <div class="grid gap-x-10 gap-y-12 md:grid-cols-3">
        {event.data.attendance.map((a) => (
          <div class="relative pt-6">
            <span aria-hidden="true" class="absolute inset-x-0 top-0 h-px bg-slate-200 dark:bg-slate-700"></span>
            <span aria-hidden="true" class="absolute left-0 top-0 h-[2px] w-8 bg-salmon-500 dark:bg-salmon-400"></span>
            <h3 class="font-serif text-xl text-slate-900 dark:text-slate-100">{a.group}</h3>
            {a.access && (
              <p class="mt-1.5 font-sans text-[10px] font-medium uppercase text-slate-400 dark:text-slate-500" style="letter-spacing: 0.22em;">
                {a.access}
              </p>
            )}
            <p class="mt-3.5 text-[15px] leading-relaxed text-slate-600 dark:text-slate-400">
              {a.note}
            </p>
          </div>
        ))}
      </div>

      {event.data.recordingNote && (
        <div class="mt-16 flex max-w-3xl items-start gap-4 rounded-xl border border-slate-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-900">
          <span aria-hidden="true" class="relative mt-1.5 flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-salmon-400 opacity-60"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-salmon-500"></span>
          </span>
          <div>
            <p class="font-sans text-[10px] font-medium uppercase text-slate-400 dark:text-slate-500" style="letter-spacing: 0.22em;">
              Recording
            </p>
            <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
              {event.data.recordingNote}
            </p>
          </div>
        </div>
      )}
    </Section>
  )}

  <!-- ─── Further details from the markdown body, if any ──────────── -->
  {hasBody && (
    <Section background="white">
      <div class="mx-auto max-w-3xl">
        <div class="prose-tmm">
          <Content />
        </div>
      </div>
    </Section>
  )}

  <!-- ─── Back ────────────────────────────────────────────────────── -->
  <Section background="white">
    <div class="text-center">
      <Button href="/events" variant="secondary">
        &larr; Back to All Events
      </Button>
    </div>
  </Section>
</PageLayout>
