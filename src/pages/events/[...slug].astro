---
import PageLayout from "../../layouts/PageLayout.astro";
import Section from "../../components/Section.astro";
import Button from "../../components/Button.astro";
import PersonCard from "../../components/PersonCard.astro";
import InterpretabilityFigure from "../../components/InterpretabilityFigure.astro";
import RetimeLocal from "../../components/RetimeLocal.astro";
import { toInstants } from "../../utils/eventTime";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const events = await getCollection("events");
  return events.map((event) => ({
    params: { slug: event.slug },
    props: { event },
  }));
}

const { event } = Astro.props;
const { Content } = await render(event);
const hasBody = (event.body ?? "").trim().length > 0;

const eventTypeLabel =
  event.data.type.charAt(0).toUpperCase() + event.data.type.slice(1);
const eyebrow = event.data.featured
  ? `${eventTypeLabel} · Featured`
  : eventTypeLabel;

// ── Date, split into typographic parts for the cover strip ───────────
const d = event.data.date;
const datePart = (opts: Intl.DateTimeFormatOptions) =>
  d ? d.toLocaleDateString("en-US", { ...opts, timeZone: "UTC" }) : "";
const dateParts = d
  ? {
      day: datePart({ day: "numeric" }),
      month: datePart({ month: "long" }),
      year: datePart({ year: "numeric" }),
      weekday: datePart({ weekday: "long" }),
    }
  : null;

// ── People and sessions ──────────────────────────────────────────────
const talks = event.data.talks ?? [];
const speakers = event.data.speakers ?? [];
const panelists = event.data.panelists ?? [];

const speakerByName = (name: string) => speakers.find((s) => s.name === name);
const panelistByName = (name: string) => panelists.find((p) => p.name === name);
const talkBySpeaker = (name: string) => talks.find((t) => t.speaker === name);

// Running order; falls back to the talks themselves when no programme is given
const rows =
  (event.data.programme?.length ?? 0) > 0
    ? event.data.programme!
    : talks.map((t) => ({ time: undefined, label: undefined, talk: t.speaker }));

const byLastName = (a: { name: string }, b: { name: string }) =>
  a.name.split(" ").pop()!.localeCompare(b.name.split(" ").pop()!);

// ── Absolute instants, so the browser can retime everything locally ──
const tz = event.data.timezone;
const instantsOf = (raw?: string) => toInstants(raw, d, tz);
const eventSpan = instantsOf(event.data.time);

// Panel membership; anyone not yet assigned to a session is shown separately
const assigned = new Set(talks.flatMap((t) => t.panel ?? []));
const unassigned = panelists.filter((p) => !assigned.has(p.name)).sort(byLastName);
const groupedPanels = talks.some((t) => (t.panel?.length ?? 0) > 0);

// ── Chapter numerals adapt to which chapters this event has ──────────
const roman = ["I", "II", "III", "IV", "V", "VI"];
const chapterIds = [
  event.data.about && "about",
  talks.length > 0 && "programme",
  talks.length === 0 && speakers.length > 0 && "speakers",
  panelists.length > 0 && !groupedPanels && "panel",
  (event.data.attendance?.length ?? 0) > 0 && "attending",
].filter(Boolean) as string[];
const numeralOf = (id: string) => roman[chapterIds.indexOf(id)];
---

<PageLayout
  title={event.data.title}
  description={event.data.description}
  eyebrow={eyebrow}
  compact
>
  <!-- ─── Cover strip: when · time · where · register ──────────────── -->
  <section class="border-b border-slate-900/10 bg-white dark:border-slate-100/10 dark:bg-slate-950">
    <div class="container-wide py-10 md:py-12">
      <dl class="grid gap-x-10 gap-y-8 sm:grid-cols-2 md:flex md:items-stretch md:gap-0 md:divide-x md:divide-slate-200 dark:md:divide-slate-800">
        <div class="flex flex-col gap-2.5 md:pr-12">
          <dt class="font-sans text-[10px] font-medium uppercase text-slate-400 dark:text-slate-500" style="letter-spacing: 0.22em;">
            When
          </dt>
          <dd>
            {dateParts ? (
              <span class="flex items-baseline gap-3.5" data-local-date={eventSpan?.start} data-tz={tz}>
                <span data-part="day" class="font-serif text-5xl leading-[0.85] tabular-nums text-slate-900 dark:text-slate-100 md:text-6xl">
                  {dateParts.day}
                </span>
                <span class="flex flex-col gap-1 font-sans text-[10px] uppercase" style="letter-spacing: 0.22em;">
                  <span data-part="month-year" class="text-slate-900 dark:text-slate-100">{dateParts.month} {dateParts.year}</span>
                  <span data-part="weekday" class="text-slate-400 dark:text-slate-500">{dateParts.weekday}</span>
                </span>
              </span>
            ) : (
              <span class="font-serif text-lg text-slate-900 dark:text-slate-100">Date to be announced</span>
            )}
          </dd>
        </div>

        {event.data.time && (
          <div class="flex flex-col gap-2.5 md:px-12">
            <dt class="font-sans text-[10px] font-medium uppercase text-slate-400 dark:text-slate-500" style="letter-spacing: 0.22em;">
              Time
            </dt>
            <dd>
              <p class="font-serif text-lg leading-snug text-slate-900 dark:text-slate-100">
                <time
                  datetime={eventSpan?.start}
                  data-local-time
                  data-end={eventSpan?.end}
                  data-tz={tz}
                >{event.data.time}</time>
              </p>
              {event.data.timeNote && (
                <p
                  class="mt-1.5 font-mono text-[11px] text-slate-500 dark:text-slate-400"
                  data-local-note
                  data-source={event.data.time}
                  data-at={eventSpan?.start}
                  data-tz={tz}
                >{event.data.timeNote}</p>
              )}
            </dd>
          </div>
        )}

        <div class="flex flex-col gap-2.5 md:px-12">
          <dt class="font-sans text-[10px] font-medium uppercase text-slate-400 dark:text-slate-500" style="letter-spacing: 0.22em;">
            Where
          </dt>
          <dd class="font-serif text-lg leading-snug text-slate-900 dark:text-slate-100">
            {event.data.location}
          </dd>
        </div>

        <div class="flex items-center sm:col-span-2 md:col-span-1 md:ml-auto md:pl-12">
          {event.data.registrationUrl ? (
            <Button href={event.data.registrationUrl} external>
              Register Now
            </Button>
          ) : (
            <p class="font-serif text-sm italic text-slate-400 dark:text-slate-500">
              Registration opens soon.
            </p>
          )}
        </div>
      </dl>
    </div>
  </section>

  <!-- ─── About ───────────────────────────────────────────────────── -->
  {event.data.about && (
    <Section background="gray" numeral={numeralOf("about")} title="About">
      {/* Beat one — the setting, and the tension in it. The figure sits
          beside the sentence that names the three model classes it draws. */}
      <div class="grid items-start gap-y-12 lg:grid-cols-[minmax(0,1fr)_300px] lg:gap-x-16">
        <p
          class="max-w-[56ch] text-pretty font-serif text-lg leading-[1.75] text-slate-700 dark:text-slate-300 md:text-xl md:leading-[1.7]"
          set:html={event.data.about}
        />
        {event.slug === "interpretability-panel" && (
          <InterpretabilityFigure class="max-w-[300px] lg:justify-self-end" />
        )}
      </div>

      {/* Beat two — the question the event exists to ask, and its facets */}
      {(event.data.aboutPull || (event.data.questions?.length ?? 0) > 0) && (
        <div class="mt-16 border-t border-slate-900/15 pt-10 dark:border-slate-100/15 md:mt-20 md:pt-14">
          {event.data.aboutPull && (
            <>
              <p class="font-sans text-[10px] font-medium uppercase text-salmon-600 dark:text-salmon-400" style="letter-spacing: 0.24em;">
                The question
              </p>
              <p class="mt-6 max-w-[22ch] font-serif text-[1.875rem] leading-[1.15] text-slate-900 dark:text-white md:text-[2.75rem]" style="letter-spacing: -0.022em;">
                {event.data.aboutPull}
              </p>
            </>
          )}

          {event.data.questions && event.data.questions.length > 0 && (
            <div class="mt-14 grid gap-x-10 gap-y-12 md:mt-16 md:grid-cols-3">
              {event.data.questions.map((q, i) => (
                <div class="relative pt-6">
                  <span aria-hidden="true" class="absolute inset-x-0 top-0 h-px bg-slate-200 dark:bg-slate-700"></span>
                  <span aria-hidden="true" class="absolute left-0 top-0 h-[2px] w-8 bg-salmon-500 dark:bg-salmon-400"></span>
                  <p class="font-mono text-xs text-salmon-600 dark:text-salmon-400">0{i + 1}</p>
                  <p class="mt-2.5 font-sans text-[11px] font-semibold uppercase text-navy-600 dark:text-navy-400" style="letter-spacing: 0.18em;">
                    {q.label}
                  </p>
                  <p class="mt-4 font-serif text-lg leading-normal text-slate-800 dark:text-slate-200">
                    {q.text}
                  </p>
                </div>
              ))}
            </div>
          )}
        </div>
      )}

      {/* Beat three — how it will be done. Quiet by design. */}
      {event.data.aboutCoda && (
        <p class="mt-16 max-w-[62ch] border-t border-slate-200 pt-8 text-[15px] leading-[1.8] text-slate-600 dark:border-slate-700 dark:text-slate-400 md:mt-20">
          {event.data.aboutCoda}
        </p>
      )}
    </Section>
  )}

  <!-- ─── Programme: each session with its speaker and panel ──────── -->
  {talks.length > 0 && (
    <Section
      background="white"
      numeral={numeralOf("programme")}
      title="Programme"
      subtitle="Four short talks, each followed by a 30-minute guided discussion with its panel."
    >
      <div>
        {rows.map((row) => {
          const talk = row.talk ? talkBySpeaker(row.talk) : undefined;

          {/* Thin rows carry the moments between sessions */}
          if (!talk) {
            const moment = instantsOf(row.time);
            return (
              <div class="flex items-center gap-5 py-5">
                {row.time && (
                  <time
                    datetime={moment?.start}
                    data-local-time
                    data-end={moment?.end}
                    data-compact
                    data-tz={tz}
                    data-ref={eventSpan?.start}
                    class="font-mono text-xs tabular-nums text-slate-400 dark:text-slate-500"
                  >{row.time}</time>
                )}
                <span class="font-sans text-sm font-medium text-slate-500 dark:text-slate-400">{row.label}</span>
                <span aria-hidden="true" class="h-px flex-1 bg-slate-200 dark:bg-slate-800"></span>
              </div>
            );
          }

          {/* A session: talk, speaker, and its discussion panel together */}
          const idx = talks.indexOf(talk);
          const sp = speakerByName(talk.speaker);
          const members = (talk.panel ?? []).flatMap((n) => {
            const p = panelistByName(n);
            return p ? [p] : [];
          });
          return (
            <article class="scroll-fade-in py-12 md:py-14">
              <header class="flex items-baseline gap-5 border-b border-slate-900/15 pb-3 dark:border-slate-100/15 md:gap-7">
                <span class="font-serif text-4xl italic leading-none text-salmon-500 dark:text-salmon-400 md:text-5xl">
                  {idx + 1}
                </span>
                <span class="font-sans text-[11px] font-semibold uppercase text-navy-600 dark:text-navy-400" style="letter-spacing: 0.18em;">
                  Session
                </span>
                {talk.time && (
                  <time
                    datetime={instantsOf(talk.time)?.start}
                    data-local-time
                    data-end={instantsOf(talk.time)?.end}
                    data-compact
                    data-tz={tz}
                    data-ref={eventSpan?.start}
                    class="ml-auto font-mono text-xs tabular-nums text-slate-400 dark:text-slate-500"
                  >{talk.time}</time>
                )}
              </header>

              <div class="mt-8 max-w-3xl">
                <h3 class="font-serif text-2xl leading-snug text-slate-900 dark:text-white md:text-3xl" style="letter-spacing: -0.01em;">
                  {talk.title}
                </h3>

                <p class="mt-3 font-sans text-sm">
                  {sp?.website ? (
                    <a href={sp.website} target="_blank" rel="noopener noreferrer" class="font-medium text-navy-600 transition-colors hover:text-salmon-600 dark:text-navy-400 dark:hover:text-salmon-400">
                      {talk.speaker}
                    </a>
                  ) : (
                    <span class="font-medium text-slate-800 dark:text-slate-200">{talk.speaker}</span>
                  )}
                  {sp?.institution && (
                    <span class="text-slate-500 dark:text-slate-400"> · {sp.institution}</span>
                  )}
                </p>

                <p class="mt-5 text-pretty text-[15px] leading-[1.8] text-slate-600 dark:text-slate-300">
                  {talk.abstract}
                </p>
              </div>

              {(sp || members.length > 0) && (
                <div class="stagger-grid mt-12 grid grid-cols-1 gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
                  {sp && (
                    <PersonCard
                      name={sp.name}
                      institution={sp.institution}
                      role={sp.role}
                      image={sp.photo}
                      photoCredit={sp.photoCredit}
                      photoCreditUrl={sp.photoCreditUrl}
                      website={sp.website}
                      links={sp.links}
                      bio={sp.bio}
                      tag="Speaker"
                      stagger={0}
                    />
                  )}
                  {members.map((person, i) => (
                    <PersonCard
                      name={person.name}
                      institution={person.institution}
                      role={person.role}
                      image={person.photo}
                      photoCredit={person.photoCredit}
                      photoCreditUrl={person.photoCreditUrl}
                      website={person.website}
                      links={person.links}
                      bio={person.bio}
                      tag="Panel"
                      stagger={Math.min((i + 1) * 70, 560)}
                    />
                  ))}
                </div>
              )}
            </article>
          );
        })}

        {groupedPanels && unassigned.length > 0 && (
          <div class="py-12 md:py-14">
            <header class="flex items-baseline gap-5 border-b border-slate-900/15 pb-3 dark:border-slate-100/15 md:gap-7">
              <span class="font-sans text-[11px] font-semibold uppercase text-slate-400 dark:text-slate-500" style="letter-spacing: 0.18em;">
                Panel to be assigned
              </span>
            </header>
            <div class="stagger-grid mt-12 grid grid-cols-1 gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
              {unassigned.map((person, i) => (
                <PersonCard
                  name={person.name}
                  institution={person.institution}
                  role={person.role}
                  image={person.photo}
                  photoCredit={person.photoCredit}
                  photoCreditUrl={person.photoCreditUrl}
                  website={person.website}
                  links={person.links}
                  bio={person.bio}
                  tag="Panel"
                  stagger={Math.min(i * 70, 560)}
                />
              ))}
            </div>
          </div>
        )}
      </div>
    </Section>
  )}

  <!-- ─── Speakers (only for events without a session programme) ──── -->
  {talks.length === 0 && speakers.length > 0 && (
    <Section background="white" numeral={numeralOf("speakers")} title="Speakers">
      <div class="stagger-grid grid grid-cols-1 gap-12 sm:grid-cols-2 lg:grid-cols-4">
        {[...speakers].sort(byLastName).map((person, i) => (
          <PersonCard
            name={person.name}
            institution={person.institution}
            role={person.role}
            image={person.photo}
            photoCredit={person.photoCredit}
            photoCreditUrl={person.photoCreditUrl}
            website={person.website}
            links={person.links}
            bio={person.bio}
            stagger={Math.min(i * 70, 560)}
          />
        ))}
      </div>
    </Section>
  )}

  <!-- ─── Discussion panel (only when not grouped into sessions) ──── -->
  {panelists.length > 0 && !groupedPanels && (
    <Section background="gray" numeral={numeralOf("panel")} title="Discussion panel" metaLabel={`${panelists.length} discussants`}>
      <div class="stagger-grid grid grid-cols-1 gap-12 sm:grid-cols-2 lg:grid-cols-4">
        {[...panelists].sort(byLastName).map((person, i) => (
          <PersonCard
            name={person.name}
            institution={person.institution}
            role={person.role}
            image={person.photo}
            photoCredit={person.photoCredit}
            photoCreditUrl={person.photoCreditUrl}
            website={person.website}
            links={person.links}
            bio={person.bio}
            stagger={Math.min(i * 70, 560)}
          />
        ))}
      </div>
    </Section>
  )}

  <!-- ─── Attending ───────────────────────────────────────────────── -->
  {event.data.attendance && event.data.attendance.length > 0 && (
    <Section background="gray" numeral={numeralOf("attending")} title="Attending" metaLabel="Practical details">
      <div class="grid gap-x-10 gap-y-12 md:grid-cols-3">
        {event.data.attendance.map((a) => (
          <div class="relative pt-6">
            <span aria-hidden="true" class="absolute inset-x-0 top-0 h-px bg-slate-200 dark:bg-slate-700"></span>
            <span aria-hidden="true" class="absolute left-0 top-0 h-[2px] w-8 bg-salmon-500 dark:bg-salmon-400"></span>
            <h3 class="font-serif text-xl text-slate-900 dark:text-slate-100">{a.group}</h3>
            <p class="mt-3.5 text-[15px] leading-relaxed text-slate-600 dark:text-slate-400">
              {a.note}
            </p>
          </div>
        ))}

        {event.data.recordingNote && (
          <div class="relative pt-6">
            <span aria-hidden="true" class="absolute inset-x-0 top-0 h-px bg-slate-200 dark:bg-slate-700"></span>
            <span aria-hidden="true" class="absolute left-0 top-0 h-[2px] w-8 bg-salmon-500 dark:bg-salmon-400"></span>
            <h3 class="flex items-center gap-2.5 font-serif text-xl text-slate-900 dark:text-slate-100">
              <span aria-hidden="true" class="relative flex h-2 w-2">
                <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-salmon-400 opacity-60"></span>
                <span class="relative inline-flex h-2 w-2 rounded-full bg-salmon-500"></span>
              </span>
              Recording
            </h3>
            <p class="mt-3.5 text-[15px] leading-relaxed text-slate-600 dark:text-slate-400">
              {event.data.recordingNote}
            </p>
          </div>
        )}
      </div>
    </Section>
  )}

  <!-- ─── Further details from the markdown body, if any ──────────── -->
  {hasBody && (
    <Section background="white">
      <div class="mx-auto max-w-3xl">
        <div class="prose-tmm">
          <Content />
        </div>
      </div>
    </Section>
  )}

  <!-- ─── Back ────────────────────────────────────────────────────── -->
  <Section background="white">
    <div class="text-center">
      <Button href="/events" variant="secondary">
        &larr; Back to All Events
      </Button>
    </div>
  </Section>
  {eventSpan && <RetimeLocal />}
</PageLayout>
