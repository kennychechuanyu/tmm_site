---
import PageLayout from "../../layouts/PageLayout.astro";
import Section from "../../components/Section.astro";
import Button from "../../components/Button.astro";
import { getCollection } from "astro:content";

const allNews = await getCollection("news");
const sortedNews = allNews.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

function formatDate(date: Date): string {
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}

function typeLabel(type: string): string {
  switch (type) {
    case "meeting-notes":
      return "Meeting Notes";
    case "announcement":
      return "Announcement";
    default:
      return "Update";
  }
}
---

<PageLayout
  title="News"
  description="Updates, meeting notes, and announcements from the TMM network."
  subtitle="Updates and meeting notes from our community"
  image="/images/share/news.png"
>
  <Section background="white" compactTop>
    {sortedNews.length > 0 ? (
      <ol class="mt-4 max-w-4xl divide-y divide-slate-900/15 border-y border-slate-900/15 dark:divide-slate-100/15 dark:border-slate-100/15">
        {sortedNews.map((post) => (
          <li class="py-7">
            <p class="flex flex-wrap gap-x-3 font-sans text-[0.9375rem] text-slate-600 dark:text-slate-400">
              <time>{formatDate(post.data.date)}</time>
              <span class="font-semibold text-accent-800 dark:text-accent-300">{typeLabel(post.data.type)}</span>
              {post.data.featured && <span class="font-semibold text-slate-800 dark:text-slate-200">Featured</span>}
            </p>
            <h2 class="mt-2 font-serif text-2xl leading-snug text-slate-900 dark:text-white">
              <a href={`/news/${post.slug}`} class="decoration-1 underline-offset-4 hover:underline">
                {post.data.title}
              </a>
            </h2>
            <p class="mt-2 text-slate-700 dark:text-slate-300">
              {post.data.description}
            </p>
            <a href={`/news/${post.slug}`} class="text-link mt-3 inline-block">Read more</a>
          </li>
        ))}
      </ol>
    ) : (
      <p class="italic text-slate-600 dark:text-slate-400">
        No news posts yet. Check back soon!
      </p>
    )}
  </Section>

  <Section background="gray">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-slate-700 dark:text-slate-300">
        Want meeting notes and announcements as they happen? Join the network to stay in the loop.
      </p>
      <Button href="/community">Join the Network</Button>
    </div>
  </Section>
</PageLayout>
