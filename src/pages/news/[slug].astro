---
import PageLayout from "../../layouts/PageLayout.astro";
import Section from "../../components/Section.astro";
import Button from "../../components/Button.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const newsEntries = await getCollection("news");
  return newsEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

function formatDate(date: Date): string {
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}

function typeLabel(type: string): string {
  switch (type) {
    case "meeting-notes":
      return "Meeting Notes";
    case "announcement":
      return "Announcement";
    default:
      return "Update";
  }
}
---

<PageLayout
  title={entry.data.title}
  description={entry.data.description}
  image={entry.data.ogImage}
  compact
>
  <Section background="white" compactTop>
    <article class="max-w-3xl">
      <a href="/news" class="text-link inline-block">Back to News</a>

      <header class="mt-6 border-b border-slate-900/15 pb-6 dark:border-slate-100/15">
        <p class="flex flex-wrap gap-x-3 font-sans text-[0.9375rem] text-slate-600 dark:text-slate-400">
          <time>{formatDate(entry.data.date)}</time>
          <span class="font-semibold text-accent-800 dark:text-accent-300">{typeLabel(entry.data.type)}</span>
        </p>
        {entry.data.author && (
          <p class="mt-2 font-sans text-[0.9375rem] text-slate-600 dark:text-slate-400">
            By {entry.data.author}
          </p>
        )}
      </header>

      <div class="prose-tmm mt-8">
        <Content />
      </div>

      <footer class="mt-12 border-t border-slate-900/15 pt-8 dark:border-slate-100/15">
        <Button href="/news" variant="secondary">
          View All News
        </Button>
      </footer>
    </article>
  </Section>
</PageLayout>
