---
import PageLayout from "../layouts/PageLayout.astro";
---

<PageLayout
  title="Page not found"
  description="That address does not exist on the TMM site."
  eyebrow="404"
  subtitle="That address does not exist here. The page may have moved, or the link may have a typo."
  compact
>
  <section class="bg-white dark:bg-slate-950">
    <div class="container-wide py-12 md:py-16">
      <p class="font-sans text-sm font-semibold text-slate-600 dark:text-slate-400">
        Try one of these
      </p>
      <ul class="mt-5 flex flex-wrap gap-x-8 gap-y-3">
        {[
          ["/", "Home"],
          ["/events/", "Events"],
          ["/people/", "People"],
          ["/about/", "About TMM"],
        ].map(([href, label]) => (
          <li>
            <a href={href} class="link font-serif text-lg">
              {label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</PageLayout>
