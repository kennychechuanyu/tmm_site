---
import PageLayout from "../../layouts/PageLayout.astro";
import Section from "../../components/Section.astro";
import ChapterHeader from "../../components/ChapterHeader.astro";
import { collections } from "../../data/collections";
import FormHandler from "../../components/FormHandler.astro";
import { formAction } from "../../utils/forms";

const FORMSPREE_ID = "xjggvlaw";

const resourceTypes = [
  "Tutorial",
  "Paper",
  "Software/Package",
  "Dataset",
  "Slides/Presentation",
  "Video",
  "Other",
];

const resources: { title: string; type: string; source: string; year: number; description: string; url: string }[] = [];
---

<PageLayout
  title="Resources"
  description="Curated resources on theory, modeling, and measurement in psychological science."
  subtitle="Curated resources on theory, modeling, and measurement in psychological science"
>
  <Section background="white" compactTop>
    <div class="max-w-5xl">
      <ChapterHeader title="Collections" class="mt-4" />
      <p class="mt-4 max-w-2xl font-serif text-lg italic leading-snug text-slate-700 dark:text-slate-300">
        Curated reading and discussion collections on the theory–measurement interface.
      </p>

      <div class="mt-10 grid gap-10 sm:grid-cols-2">
        {collections.map((c) => (
          <a
            href={`/resources/${c.slug}`}
            class="group flex flex-col border-t border-slate-900 pt-5 dark:border-slate-100"
          >
            <span class="font-sans text-sm font-semibold text-accent-800 dark:text-accent-300">
              {c.type}
            </span>
            <h2 class="mt-2 font-serif text-2xl leading-snug text-slate-900 decoration-1 underline-offset-4 group-hover:underline dark:text-white">
              {c.title}
            </h2>
            <p class="mt-2 flex-1 text-base leading-relaxed text-slate-700 dark:text-slate-300">
              {c.blurb}
            </p>
          </a>
        ))}
      </div>
    </div>
  </Section>

  {resources.length > 0 && (
    <Section background="gray">
      <div class="max-w-6xl">
        <ChapterHeader title="All Resources" />

        <div class="mt-8 flex flex-wrap gap-2" id="resource-filter">
          <button data-filter="all" class="btn-secondary is-active">All</button>
          {[...new Set(resources.map((r) => r.type))].map((t) => (
            <button data-filter={t} class="btn-secondary">{t}</button>
          ))}
        </div>

        <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" id="resource-grid">
          {resources.map((resource) => (
            <a
              href={resource.url}
              target="_blank"
              rel="noopener noreferrer"
              data-type={resource.type}
              class="resource-item group block border-t border-slate-900/15 pt-5 dark:border-slate-100/15"
            >
              <span class="mb-2 inline-block font-sans text-sm font-semibold text-accent-800 dark:text-accent-300">
                {resource.type}
              </span>
              <h3 class="font-serif text-lg leading-snug text-slate-900 decoration-1 underline-offset-4 group-hover:underline dark:text-white">
                {resource.title}
              </h3>
              <div class="mt-2 flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
                <span class="font-serif italic">{resource.source}</span>
                <span class="text-slate-300 dark:text-slate-600">&middot;</span>
                <span>{resource.year}</span>
              </div>
              <p class="mt-3 text-sm leading-relaxed text-slate-600 line-clamp-3 dark:text-slate-400">
                {resource.description}
              </p>
            </a>
          ))}
        </div>
      </div>
    </Section>
  )}

  <Section background="gray">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-slate-700 dark:text-slate-300">
        Have a tutorial, tool, or paper to share? We welcome contributions from the TMM community.
      </p>
      <button id="open-modal-btn" class="btn-primary flex-shrink-0">
        Submit a Resource
      </button>
    </div>
  </Section>

  <div
    id="resource-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center overflow-y-auto bg-black/50 p-4"
  >
    <div class="relative my-8 w-full max-w-lg rounded-md bg-white p-6 shadow-2xl dark:bg-slate-900">
      <button
        id="close-modal-btn"
        class="absolute right-4 top-4 text-slate-400 hover:text-slate-600 dark:hover:text-slate-300"
      >
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <h2 class="text-xl font-semibold text-slate-900 dark:text-white">Submit a Resource</h2>
      <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
        Share a resource with the TMM community.
      </p>

      <form
        action={formAction(FORMSPREE_ID)}
        method="POST"
        class="mt-6 space-y-4"
        data-site-form="resource"
        data-success="resource-success"
      >
        <input type="hidden" name="_subject" value="New Resource Submission" />
        <input type="hidden" name="form" value="resource" />
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" style="display:none" />

        <div>
          <label for="name" class="label">Your Name *</label>
          <input type="text" id="name" name="name" required class="input" placeholder="Your name" />
        </div>

        <div>
          <label for="email" class="label">Email *</label>
          <input type="email" id="email" name="email" required class="input" placeholder="your@email.com" />
        </div>

        <div>
          <label for="title" class="label">Resource Title *</label>
          <input type="text" id="title" name="resource_title" required class="input" placeholder="Title of your resource" />
        </div>

        <div>
          <label for="type" class="label">Resource Type *</label>
          <select id="type" name="resource_type" required class="input">
            <option value="">Select type</option>
            {resourceTypes.map((type) => (
              <option value={type}>{type}</option>
            ))}
          </select>
        </div>

        <div>
          <label for="description" class="label">Description *</label>
          <textarea id="description" name="description" required rows="3" class="input" placeholder="Brief description of the resource"></textarea>
        </div>

        <div>
          <label for="url" class="label">URL (optional)</label>
          <input type="url" id="url" name="resource_url" class="input" placeholder="https://..." />
          <p class="mt-1 text-xs text-slate-500">A DOI, a publisher page, or a share link (Drive, OSF) if it is a file of your own.</p>
        </div>

        <div class="pt-2">
          <button type="submit" class="btn-primary w-full">Submit Resource</button>
        </div>
      </form>

      <div id="resource-success" class="mt-6 hidden">
        <p class="font-serif text-lg text-slate-900 dark:text-white">Thank you. Your suggestion has been sent.</p>
        <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">We look at every suggestion and add it to the collection when it fits.</p>
      </div>
    </div>
  </div>
<FormHandler />
</PageLayout>

<script>
  const modal = document.getElementById("resource-modal");
  const openBtn = document.getElementById("open-modal-btn");
  const closeBtn = document.getElementById("close-modal-btn");

  function openModal() {
    modal?.classList.remove("hidden");
    modal?.classList.add("flex");
    document.body.style.overflow = "hidden";
  }
  function closeModal() {
    modal?.classList.add("hidden");
    modal?.classList.remove("flex");
    document.body.style.overflow = "";
  }
  openBtn?.addEventListener("click", openModal);
  closeBtn?.addEventListener("click", closeModal);
  modal?.addEventListener("click", (e) => {
    if (e.target === modal) closeModal();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !modal?.classList.contains("hidden")) closeModal();
  });

  const filterBar = document.getElementById("resource-filter");
  filterBar?.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-filter]");
    if (!btn) return;
    const want = btn.getAttribute("data-filter");
    filterBar.querySelectorAll("[data-filter]").forEach((b) => b.classList.toggle("is-active", b === btn));
    document.querySelectorAll<HTMLElement>("#resource-grid .resource-item").forEach((item) => {
      item.style.display = want === "all" || item.getAttribute("data-type") === want ? "" : "none";
    });
  });
</script>
