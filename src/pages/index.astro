---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ChapterHeader from "../components/ChapterHeader.astro";
import { toInstants, hasEnded } from "../utils/eventTime";
import { getCollection } from "astro:content";

const allEvents = await getCollection("events");
const now = new Date();
const upcomingEvents = allEvents
  .filter((event) => !hasEnded(event.data, now))
  .sort((a, b) => {
    const ad = a.data.date?.getTime() ?? -Infinity;
    const bd = b.data.date?.getTime() ?? -Infinity;
    return ad - bd;
  })
  .slice(0, 3);
const pastEvents = allEvents
  .filter((event) => hasEnded(event.data, now))
  .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0))
  .slice(0, 3);

const activities = [
  {
    title: "Unite disciplines",
    description:
      "Bringing together cognitive modelers, psychometricians, experimentalists, and philosophers.",
  },
  {
    title: "Foster dialogue",
    description:
      "Creating spaces where theoretical, modeling, and methodological assumptions can be questioned.",
  },
  {
    title: "Organize events",
    description:
      "Hosting workshops and conferences where conversations translate into concrete progress.",
  },
  {
    title: "Build collaborations",
    description:
      "Providing a platform where joint research projects can emerge from shared understanding.",
  },
];

const focusAreas = [
  {
    title: "Theory–Measurement Gap",
    description:
      "What we measure often isn't what we theorize. We expose the hidden assumptions.",
  },
  {
    title: "Prediction–Explanation Gap",
    description:
      "Good predictions can come from bad theories. We investigate what it really takes for a model to explain.",
  },
  {
    title: "Cumulative Science",
    description:
      "Evidence for theories and evidence for measures get tangled. We work to untangle them so both can genuinely accumulate.",
  },
];

const heroDescription =
  "TMM is an international network addressing the disconnect between what psychologists <em>theorize</em>, what they <em>model</em>, and what they actually <em>measure</em>.";
---

<BaseLayout
  title="TMM — Theory, Model, Measurement"
  description="An international network addressing the disconnect between what psychologists theorize, what they model, and what they actually measure."
>
  <Hero
    subtitle="Bridging Theory and Measurement in Psychology"
    description={heroDescription}
    primaryCTA={{ label: "Join the Network", href: "/community" }}
  />

  <section class="section bg-white dark:bg-slate-950">
    <div class="container-wide">
      <ChapterHeader title="Upcoming Events" class="mb-8 md:mb-10" />

      {upcomingEvents.length > 0 ? (
        <ol class="divide-y divide-slate-900/15 border-y border-slate-900/15 dark:divide-slate-100/15 dark:border-slate-100/15">
          {upcomingEvents.map((event) => {
            const d = event.data.date;
            const part = (o: Intl.DateTimeFormatOptions) =>
              d!.toLocaleDateString("en-US", { ...o, timeZone: "UTC" });
            const day = d ? part({ day: "numeric" }) : null;
            const month = d ? part({ month: "short" }) : null;
            const year = d ? part({ year: "numeric" }) : null;
            const weekday = d ? part({ weekday: "long" }) : "Date TBD";
            const startsAt = toInstants(event.data.time, d, event.data.timezone)?.start
              ?? d?.toISOString();
            const typeLabel = event.data.type.charAt(0).toUpperCase() + event.data.type.slice(1);
            return (
              <li
                data-local-date={startsAt}
                data-tz={event.data.timezone}
                class="relative grid grid-cols-[5.5rem_1fr] items-start gap-x-6 gap-y-4 py-6 sm:grid-cols-[7rem_1fr_auto] md:gap-x-10 md:py-7"
              >
                <div class="text-slate-900 dark:text-slate-100">
                  {d ? (
                    <>
                      <span data-part="day" class="block font-serif text-4xl leading-none tabular-nums md:text-5xl">
                        {day}
                      </span>
                      <span class="mt-2 block font-sans text-sm text-slate-600 dark:text-slate-400">
                        <span data-part="month-short">{month}</span> <span data-part="year">{year}</span>
                      </span>
                      <span data-part="weekday" class="block font-sans text-sm text-slate-500 dark:text-slate-400">{weekday}</span>
                    </>
                  ) : (
                    <span class="font-serif text-2xl italic text-slate-500">TBD</span>
                  )}
                </div>

                <div class="min-w-0">
                  <h3 class="font-serif text-xl leading-snug text-slate-900 dark:text-slate-100 md:text-2xl">
                    <a href={`/events/${event.slug}/`} class="after:absolute after:inset-0 after:content-[''] hover:underline hover:decoration-1 hover:underline-offset-4">{event.data.title}</a>
                  </h3>
                  <p class="mt-2 flex flex-wrap gap-x-3 font-sans text-[0.9375rem] text-slate-600 dark:text-slate-400">
                    <span class="font-semibold text-accent-800 dark:text-accent-300">{typeLabel}</span>
                    {event.data.featured && <span class="font-semibold text-slate-800 dark:text-slate-200">Featured</span>}
                    <span>{event.data.location}</span>
                  </p>
                </div>

                <div class="col-span-2 sm:col-span-1 sm:self-center sm:justify-self-end">
                  <a href={`/events/${event.slug}/`} class="btn-secondary relative z-10">
                    Programme and registration
                  </a>
                </div>
              </li>
            );
          })}
        </ol>
      ) : (
        <div class="border-y border-slate-900/15 py-12 dark:border-slate-100/15">
          <p class="font-serif text-xl italic text-slate-600 dark:text-slate-400">
            No events currently scheduled. Check back soon.
          </p>
        </div>
      )}

      {pastEvents.length > 0 && (
        <div class="mt-12 md:mt-14">
          <h3 class="font-serif text-xl text-slate-900 dark:text-slate-100 md:text-2xl">Past Events</h3>
          <ol class="mt-4 divide-y divide-slate-900/15 border-y border-slate-900/15 dark:divide-slate-100/15 dark:border-slate-100/15">
            {pastEvents.map((event) => {
              const d = event.data.date!;
              const part = (o: Intl.DateTimeFormatOptions) =>
                d.toLocaleDateString("en-US", { ...o, timeZone: "UTC" });
              const typeLabel = event.data.type.charAt(0).toUpperCase() + event.data.type.slice(1);
              return (
                <li>
                  <a
                    href={`/events/${event.slug}/`}
                    class="group grid grid-cols-[5.5rem_1fr] items-start gap-x-6 py-6 sm:grid-cols-[7rem_1fr] md:gap-x-10 md:py-7"
                  >
                    <div class="text-slate-700 dark:text-slate-300">
                      <span class="block font-serif text-4xl leading-none tabular-nums md:text-5xl">{part({ day: "numeric" })}</span>
                      <span class="mt-2 block font-sans text-sm text-slate-600 dark:text-slate-400">
                        {part({ month: "short" })} {part({ year: "numeric" })}
                      </span>
                      <span class="block font-sans text-sm text-slate-500 dark:text-slate-400">{part({ weekday: "long" })}</span>
                    </div>
                    <div class="min-w-0">
                      <h4 class="font-serif text-xl leading-snug text-slate-900 decoration-1 underline-offset-4 group-hover:underline dark:text-slate-100 md:text-2xl">
                        {event.data.title}
                      </h4>
                      <p class="mt-2 flex flex-wrap gap-x-3 font-sans text-[0.9375rem] text-slate-600 dark:text-slate-400">
                        <span class="font-semibold text-slate-700 dark:text-slate-300">{typeLabel}</span>
                        <span>{event.data.location}</span>
                      </p>
                    </div>
                  </a>
                </li>
              );
            })}
          </ol>
        </div>
      )}

      <div class="mt-6">
        <a href="/events" class="text-link">View all events</a>
      </div>
    </div>
  </section>

  <section class="section border-y border-slate-900/10 bg-slate-50 dark:border-slate-100/10 dark:bg-slate-900/50">
    <div class="container-wide">
      <ChapterHeader title="What We Do" class="mb-10 md:mb-14" />

      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <p class="font-serif text-3xl leading-[1.15] text-slate-900 dark:text-slate-100 md:text-[2.5rem]">
            Psychologists <em>theorize</em>, <em>model</em>, and <em>measure</em> in disconnected ways.
          </p>
          <p class="mt-6 font-serif text-2xl italic leading-snug text-slate-700 dark:text-slate-300 md:text-[1.75rem]">
            We work to align them.
          </p>
        </div>

        <div class="lg:col-span-7">
          <ul class="divide-y divide-slate-900/15 border-y border-slate-900/15 dark:divide-slate-100/15 dark:border-slate-100/15">
            {activities.map((activity) => (
              <li class="py-6 md:py-7">
                <h3 class="font-serif text-xl leading-tight text-slate-900 dark:text-slate-100 md:text-[1.375rem]">
                  {activity.title}
                </h3>
                <p class="mt-2 max-w-xl text-pretty text-[1.0625rem] leading-relaxed text-slate-700 dark:text-slate-300">
                  {activity.description}
                </p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-white dark:bg-slate-950">
    <div class="container-wide">
      <ChapterHeader title="Our Focus" class="mb-10 md:mb-14" />

      <div class="grid gap-10 md:grid-cols-3 md:gap-12">
        {focusAreas.map((area) => (
          <article class="border-t border-slate-900 pt-5 dark:border-slate-100">
            <h3 class="font-serif text-2xl leading-[1.2] text-slate-900 dark:text-slate-100">
              {area.title}
            </h3>
            <p class="mt-3 text-pretty text-[1.0625rem] leading-relaxed text-slate-700 dark:text-slate-300">
              {area.description}
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
