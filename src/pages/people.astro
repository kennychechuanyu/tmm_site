---
import PageLayout from "../layouts/PageLayout.astro";
import Section from "../components/Section.astro";
import ChapterHeader from "../components/ChapterHeader.astro";
import PersonCard from "../components/PersonCard.astro";

import { coordinatingCommittee, networkMembers, sortByName } from "../data/people";
---

<PageLayout
  title="People"
  description="The coordinating team and members of the TMM network: researchers in cognitive modelling, mathematical psychology, psychometrics, machine learning and philosophy of science working on how theory, models and measurement fit together."
  image="/images/share/people.png"
>
  <Section background="white">
    <div>
      <p class="mb-8 font-sans text-[0.9375rem] text-slate-600 dark:text-slate-400">
        Each group is ordered alphabetically by last name.
      </p>
      <ChapterHeader title="Coordinating Team" />

      <div class="mt-10 grid grid-cols-2 gap-x-5 gap-y-10 sm:gap-x-8 sm:gap-y-12 lg:grid-cols-3">
        {coordinatingCommittee.sort(sortByName).map((member) => (
          <PersonCard
            name={member.name}
            institution={member.institution}
            role={member.role}
            image={member.image}
            photoCredit={(member as any).photoCredit}
            photoCreditUrl={(member as any).photoCreditUrl}
            email={member.email}
            website={member.website}
            website2={member.website2}
            links={(member as any).links}
            bio={member.bio}
          />
        ))}
      </div>
    </div>
  </Section>

  <Section background="gray">
    <div>
      <ChapterHeader title="Network Members" />

      <div class="mt-10 grid grid-cols-2 gap-x-5 gap-y-10 sm:gap-x-8 sm:gap-y-12 lg:grid-cols-3">
        {networkMembers.sort(sortByName).map((member) => (
          <PersonCard
            name={member.name}
            institution={member.institution}
            role={member.role}
            image={member.image}
            photoCredit={(member as any).photoCredit}
            photoCreditUrl={(member as any).photoCreditUrl}
            email={member.email}
            website={member.website}
            website2={(member as any).website2}
            links={(member as any).links}
            bio={member.bio}
          />
        ))}
      </div>
    </div>
  </Section>
</PageLayout>
